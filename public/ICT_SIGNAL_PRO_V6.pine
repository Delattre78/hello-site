//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  ICT SIGNAL PRO V6 — FULL ENGINE (Pine Script v6)
//  EURUSD · NASDAQ · DOW JONES · S&P500   |   TF conseillé : 5m / 15m
//
//  GRAPHIQUE 100% PROPRE : seuls les signaux BUY / SELL sont affichés.
//  TOUT le reste est calculé en interne et restitué dans le dashboard :
//   · Volume Profile réel (POC / VAH / VAL, value area 70%)
//   · Order Flow (delta CLV, delta cumulé fenêtré, imbalance, absorption,
//     divergences delta/prix)
//   · ICT complet : MSS / CHoCH / BOS / FVG (avec invalidation) / Order
//     Blocks / Breakers / PO3 / Judas NY / OTE / Premium-Discount / Sweeps
//     SSL-BSL / EQH-EQL / Killzones / NY Midnight / Asian Range
//   · Biais multi-timeframe 1H-4H-D-W-M, momentum (EMA/VWAP/RSI/Stoch/
//     MACD/Ichimoku/BB/ADX), patterns chandeliers, displacement
//   · Annonces économiques : blocage ± X min + compte à rebours
//
//  CORRECTIFS vs V3/V5 :
//   · EQH/EQL : comparaison AVANT mise à jour du pivot (avant: jamais vrai)
//   · PDH/PDL/PWH/PWL : lookahead_on + [1] (avant: décalé d'un jour)
//   · MSS/CHoCH : fenêtre de sweep (avant: 2 barres consécutives = ~jamais)
//   · FVG & OB : invalidation quand traversés + expiration (avant: zombies)
//   · Cum delta : fenêtre glissante 50 barres (avant: dérive infinie ta.cum)
//   · Volume profile : vrais bins de prix (avant: close du max volume)
// ═══════════════════════════════════════════════════════════════════════════
indicator("ICT SIGNAL PRO V6 — FULL ENGINE", overlay=true, max_labels_count=500, max_lines_count=100)

// ─────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────
grpR = "Risk & R:R"
rr1     = input.float(1.5, "TP1 R:R",        group=grpR, minval=0.5, step=0.25)
rr2     = input.float(2.5, "TP2 R:R",        group=grpR, minval=1.0, step=0.25)
rr3     = input.float(3.5, "TP3 R:R",        group=grpR, minval=1.5, step=0.25)
riskPct = input.float(1.0, "Risk % / trade", group=grpR, minval=0.1, step=0.1)

grpF = "Filtres signal"
minScoreL = input.int(26, "Score MIN Long  /50",  group=grpF, minval=15, maxval=50)
minScoreS = input.int(26, "Score MIN Short /50",  group=grpF, minval=15, maxval=50)
htf       = input.timeframe("60",  "HTF 1",          group=grpF)
htf2      = input.timeframe("240", "HTF 2",          group=grpF)
swingLen  = input.int(10,  "Swing length",          group=grpF, minval=3, maxval=30)
sweepWin  = input.int(10,  "Fenêtre sweep (barres)", group=grpF, minval=3, maxval=30)
structWin = input.int(12,  "Fenêtre structure",      group=grpF, minval=4, maxval=40)
atrLen    = input.int(14,  "ATR length",             group=grpF, minval=5)
atrMult   = input.float(1.0, "SL ATR buffer",        group=grpF, step=0.1, minval=0.3)
minATR    = input.float(0.8, "Filtre volatilité xATR moy", group=grpF, step=0.05)

grpVP = "Volume Profile / Order Flow"
vpLen    = input.int(150, "Profondeur profil (barres)", group=grpVP, minval=50, maxval=300)
vpBins   = input.int(24,  "Niveaux de prix (bins)",     group=grpVP, minval=10, maxval=40)
vaPct    = input.float(0.70, "Value Area %",            group=grpVP, minval=0.5, maxval=0.9, step=0.05)
ofWin    = input.int(50,  "Fenêtre delta cumulé",       group=grpVP, minval=20, maxval=200)

grpS = "Sessions (heure Paris)"
useLondon = input.bool(true, "Killzone London 08h00-11h00", group=grpS)
useNY     = input.bool(true, "Killzone NY 15h30-20h00",     group=grpS)

grpN = "Annonces économiques (UTC)"
useNews = input.bool(true, "Bloquer trading ± X min", group=grpN)
newsMin = input.int(30, "Minutes avant/après", group=grpN, minval=5, maxval=120)
news1  = input.time(timestamp("17 Jun 2026 18:00 +0000"), "News 1  (FOMC)",   group=grpN)
news2  = input.time(timestamp("26 Jun 2026 12:30 +0000"), "News 2  (PCE)",    group=grpN)
news3  = input.time(timestamp("01 Jul 2026 14:00 +0000"), "News 3  (ISM)",    group=grpN)
news4  = input.time(timestamp("02 Jul 2026 12:30 +0000"), "News 4  (NFP)",    group=grpN)
news5  = input.time(timestamp("14 Jul 2026 12:30 +0000"), "News 5  (CPI)",    group=grpN)
news6  = input.time(timestamp("15 Jul 2026 12:30 +0000"), "News 6  (PPI)",    group=grpN)
news7  = input.time(timestamp("16 Jul 2026 12:30 +0000"), "News 7  (Retail)", group=grpN)
news8  = input.time(timestamp("29 Jul 2026 18:00 +0000"), "News 8  (FOMC)",   group=grpN)
news9  = input.time(timestamp("31 Jul 2026 12:30 +0000"), "News 9  (PCE)",    group=grpN)
news10 = input.time(timestamp("07 Aug 2026 12:30 +0000"), "News 10 (NFP)",    group=grpN)

grpD = "Affichage (chart clean)"
showLbl   = input.bool(true,  "Label BUY/SELL (entry/SL/TP/raisons)", group=grpD)
showLines = input.bool(false, "Lignes SL/TP du dernier signal",       group=grpD)
dbOn      = input.bool(true,  "Dashboard",                            group=grpD)
dbRight   = input.bool(true,  "Dashboard à droite (sinon gauche)",    group=grpD)

// ─────────────────────────────────────────────────────────────────────
//  NEWS — blocage + compte à rebours
// ─────────────────────────────────────────────────────────────────────
nwMs = newsMin * 60000
nn(t) => math.abs(time - t) <= nwMs
newsBlocked = useNews and (nn(news1) or nn(news2) or nn(news3) or nn(news4) or nn(news5) or nn(news6) or nn(news7) or nn(news8) or nn(news9) or nn(news10))

// prochaine annonce dans le futur
nxt(best, t) => t > time and (na(best) or t < best) ? t : best
int nextNews = na
nextNews := nxt(nextNews, news1)
nextNews := nxt(nextNews, news2)
nextNews := nxt(nextNews, news3)
nextNews := nxt(nextNews, news4)
nextNews := nxt(nextNews, news5)
nextNews := nxt(nextNews, news6)
nextNews := nxt(nextNews, news7)
nextNews := nxt(nextNews, news8)
nextNews := nxt(nextNews, news9)
nextNews := nxt(nextNews, news10)

newsCountdown() =>
    if na(nextNews)
        "---"
    else
        mLeft = (nextNews - time) / 60000
        d = int(mLeft / 1440)
        h = int((mLeft % 1440) / 60)
        m = int(mLeft % 60)
        d > 0 ? str.tostring(d) + "j " + str.tostring(h) + "h" : h > 0 ? str.tostring(h) + "h " + str.tostring(m) + "m" : str.tostring(m) + "min"

// ─────────────────────────────────────────────────────────────────────
//  SESSIONS & NIVEAUX TEMPORELS
// ─────────────────────────────────────────────────────────────────────
inLondon   = useLondon and not na(time(timeframe.period, "0800-1100", "Europe/Paris"))
inNY       = useNY     and not na(time(timeframe.period, "1530-2000", "Europe/Paris"))
inAsian    = not na(time(timeframe.period, "0100-0800", "Europe/Paris"))
inKillzone = inLondon or inNY

var float nyMidnightPx = na
if not na(time(timeframe.period, "0000-0001", "America/New_York"))
    nyMidnightPx := open

// Range asiatique (reset chaque jour)
var float asianH = na
var float asianL = na
if ta.change(time("D")) != 0
    asianH := na
    asianL := na
if inAsian
    asianH := na(asianH) ? high : math.max(asianH, high)
    asianL := na(asianL) ? low  : math.min(asianL, low)

// Range London (pour Judas NY)
var float ldnH = na
var float ldnL = na
if ta.change(time("D")) != 0
    ldnH := na
    ldnL := na
if not na(time(timeframe.period, "0800-1100", "Europe/Paris"))
    ldnH := na(ldnH) ? high : math.max(ldnH, high)
    ldnL := na(ldnL) ? low  : math.min(ldnL, low)

// Niveaux veille/semaine — FIX: lookahead_on + [1] = vraie valeur de la veille, sans repaint
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pwH = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwL = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)

// ─────────────────────────────────────────────────────────────────────
//  BIAIS MULTI-TIMEFRAME (valeurs confirmées, sans repaint)
// ─────────────────────────────────────────────────────────────────────
h1C    = request.security(syminfo.tickerid, htf,  close,             lookahead=barmerge.lookahead_off)
h1E21  = request.security(syminfo.tickerid, htf,  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
h1E50  = request.security(syminfo.tickerid, htf,  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h1E200 = request.security(syminfo.tickerid, htf,  ta.ema(close,200), lookahead=barmerge.lookahead_off)
h1Rsi  = request.security(syminfo.tickerid, htf,  ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
h4C    = request.security(syminfo.tickerid, htf2, close,             lookahead=barmerge.lookahead_off)
h4E50  = request.security(syminfo.tickerid, htf2, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h4E200 = request.security(syminfo.tickerid, htf2, ta.ema(close,200), lookahead=barmerge.lookahead_off)
dC     = request.security(syminfo.tickerid, "D",  close,             lookahead=barmerge.lookahead_off)
dE21   = request.security(syminfo.tickerid, "D",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
dE50   = request.security(syminfo.tickerid, "D",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
wC     = request.security(syminfo.tickerid, "W",  close,             lookahead=barmerge.lookahead_off)
wE50   = request.security(syminfo.tickerid, "W",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
mC     = request.security(syminfo.tickerid, "M",  close,             lookahead=barmerge.lookahead_off)
mE21   = request.security(syminfo.tickerid, "M",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)

bull1H = h1C > h1E21 and h1E21 > h1E50 and h1C > h1E200 and h1Rsi > 50
bear1H = h1C < h1E21 and h1E21 < h1E50 and h1C < h1E200 and h1Rsi < 50
bull4H = h4C > h4E50 and h4C > h4E200
bear4H = h4C < h4E50 and h4C < h4E200
bullD  = dC > dE21 and dE21 > dE50
bearD  = dC < dE21 and dE21 < dE50
bullW  = wC > wE50
bearW  = wC < wE50
bullM  = mC > mE21
bearM  = mC < mE21

tripleBull = bull1H and bull4H and bullD
tripleBear = bear1H and bear4H and bearD
quadBull   = tripleBull and bullW
quadBear   = tripleBear and bearW
pentaBull  = quadBull and bullM
pentaBear  = quadBear and bearM

// ─────────────────────────────────────────────────────────────────────
//  ATR & VOLATILITÉ
// ─────────────────────────────────────────────────────────────────────
atr          = ta.atr(atrLen)
atrAvg       = ta.sma(atr, 50)
volFilter    = atr >= atrAvg * minATR
atrExpanding = atr > atr[1] and atr[1] > atr[2]

// ─────────────────────────────────────────────────────────────────────
//  VOLUME PROFILE RÉEL — POC / VAH / VAL (bins de prix, value area 70%)
// ─────────────────────────────────────────────────────────────────────
var float[] vpVol = array.new_float(vpBins, 0.0)

vpHi   = ta.highest(high, vpLen)
vpLo   = ta.lowest(low, vpLen)
vpStep = (vpHi - vpLo) / vpBins

float poc = na
float vaH = na
float vaL = na
if vpStep > 0
    array.fill(vpVol, 0.0)
    for i = 0 to vpLen - 1
        px  = hl2[i]
        idx = int(math.min(vpBins - 1, math.max(0, (px - vpLo) / vpStep)))
        array.set(vpVol, idx, array.get(vpVol, idx) + nz(volume[i]))
    // POC = bin au volume max
    pocIdx = 0
    pocVol = 0.0
    totVol = 0.0
    for i = 0 to vpBins - 1
        v = array.get(vpVol, i)
        totVol += v
        if v > pocVol
            pocVol := v
            pocIdx := i
    // Value Area : expansion depuis le POC jusqu'à vaPct du volume total
    vaVol = pocVol
    upI   = pocIdx + 1
    dnI   = pocIdx - 1
    upE   = pocIdx
    dnE   = pocIdx
    for k = 0 to vpBins
        if vaVol >= totVol * vaPct
            break
        upV = upI <= vpBins - 1 ? array.get(vpVol, upI) : -1.0
        dnV = dnI >= 0          ? array.get(vpVol, dnI) : -1.0
        if upV < 0 and dnV < 0
            break
        if upV >= dnV
            vaVol += upV
            upE := upI
            upI += 1
        else
            vaVol += dnV
            dnE := dnI
            dnI -= 1
    poc := vpLo + (pocIdx + 0.5) * vpStep
    vaH := vpLo + (upE + 1.0) * vpStep
    vaL := vpLo + (dnE + 0.0) * vpStep

vpDiscount = not na(vaL) and close < vaL                        // sous la value area
vpPremium  = not na(vaH) and close > vaH                        // au-dessus de la value area
nearPOC    = not na(poc) and math.abs(close - poc) < atr * 0.3  // aimant POC
vpReclaimB = not na(vaL) and low  < vaL and close > vaL and close > open   // reprise de la VAL
vpReclaimS = not na(vaH) and high > vaH and close < vaH and close < open   // rejet de la VAH
abovePOC   = not na(poc) and close > poc
belowPOC   = not na(poc) and close < poc

// ─────────────────────────────────────────────────────────────────────
//  ORDER FLOW — delta CLV, cumul fenêtré, imbalance, absorption, divergences
// ─────────────────────────────────────────────────────────────────────
volAvg    = ta.sma(volume, 20)
vSpk      = volume > volAvg * 1.5
vSuperSpk = volume > volAvg * 2.5

// Delta estimé via Close Location Value : position du close dans le range
clv      = high != low ? ((close - low) - (high - close)) / (high - low) : 0.0
deltaBar = nz(volume) * clv
delta3   = math.sum(deltaBar, 3)
cumDelta = math.sum(deltaBar, ofWin)        // FIX: fenêtre glissante, pas ta.cum infini

ofImbBull = clv >  0.6 and volume > volAvg * 1.2   // barre très acheteuse
ofImbBear = clv < -0.6 and volume > volAvg * 1.2   // barre très vendeuse

// Absorption : gros volume, petit range → ordres absorbés (réversal probable)
smallRange = (high - low) < atr * 0.7
absBull = vSuperSpk and smallRange and clv > 0.2  and close >= open   // vendeurs absorbés
absBear = vSuperSpk and smallRange and clv < -0.2 and close <= open   // acheteurs absorbés

// Divergences delta / prix
cdBullDiv = close < close[5] and cumDelta > cumDelta[5]
cdBearDiv = close > close[5] and cumDelta < cumDelta[5]
ofBull    = ta.ema(deltaBar, 5) > 0
ofBear    = ta.ema(deltaBar, 5) < 0

// ─────────────────────────────────────────────────────────────────────
//  MOMENTUM : EMA / VWAP / RSI / STOCH / MACD / ICHIMOKU / BB / ADX
// ─────────────────────────────────────────────────────────────────────
e8   = ta.ema(close, 8)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
vwap = ta.vwap(hlc3)
bMom = close > e21 and e8 > e21 and close > vwap and e21 > e50
sMom = close < e21 and e8 < e21 and close < vwap and e21 < e50

rsi         = ta.rsi(close, 14)
stochK      = ta.stoch(rsi, rsi, rsi, 14)
stochD      = ta.ema(stochK, 3)
rsiBullZone = rsi > 45 and rsi < 72
rsiBearZone = rsi < 55 and rsi > 28
rbdiv       = rsi < 40 and close < close[5] and rsi > rsi[5]
rsdiv       = rsi > 60 and close > close[5] and rsi < rsi[5]
stochXupOS  = ta.crossover(stochK, stochD)  and stochK < 30
stochXdnOB  = ta.crossunder(stochK, stochD) and stochK > 70

[macdL, macdSg, macdHst] = ta.macd(close, 12, 26, 9)
macdBull = macdL > macdSg and macdHst > 0 and macdHst > macdHst[1]
macdBear = macdL < macdSg and macdHst < 0 and macdHst < macdHst[1]
macdXup  = ta.crossover(macdL,  macdSg) and macdL < 0
macdXdn  = ta.crossunder(macdL, macdSg) and macdL > 0

ichiT = (ta.highest(high, 9)  + ta.lowest(low, 9))  / 2
ichiK = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
ichiA = (ichiT + ichiK) / 2
ichiB = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2
ichiBull = close > math.max(ichiA[26], ichiB[26]) and ichiT > ichiK
ichiBear = close < math.min(ichiA[26], ichiB[26]) and ichiT < ichiK

bbMid   = ta.sma(close, 20)
bbDev   = ta.stdev(close, 20)
atBBLow  = close <= (bbMid - bbDev * 2.0) * 1.002
atBBHigh = close >= (bbMid + bbDev * 2.0) * 0.998

[diP, diM, adx] = ta.dmi(14, 14)
adxTrending = adx > 20
adxBull     = adxTrending and diP > diM
adxBear     = adxTrending and diM > diP

// ─────────────────────────────────────────────────────────────────────
//  LIQUIDITÉ — sweeps SSL/BSL fenêtrés + EQH/EQL (corrigés)
// ─────────────────────────────────────────────────────────────────────
liqH = ta.highest(high[1], swingLen)
liqL = ta.lowest(low[1],   swingLen)

wickDn = math.min(open, close) - low
wickUp = high - math.max(open, close)

sslRaw = low  < liqL and close > liqL and wickDn > atr * 0.25 and close > open
bslRaw = high > liqH and close < liqH and wickUp > atr * 0.25 and close < open

sinceSSL  = nz(ta.barssince(sslRaw), 99999)
sinceBSL  = nz(ta.barssince(bslRaw), 99999)
sweepBull = sinceSSL <= sweepWin      // FIX: fenêtre au lieu d'exiger 2 barres consécutives
sweepBear = sinceBSL <= sweepWin

// EQH/EQL — FIX: comparer au pivot PRÉCÉDENT avant de le mettre à jour
ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow(low,  5, 5)
var float prevPH5 = na
var float prevPL5 = na
eqH = false
eqL = false
if not na(ph5)
    eqH := not na(prevPH5) and math.abs(ph5 - prevPH5) < atr * 0.12
    prevPH5 := ph5
if not na(pl5)
    eqL := not na(prevPL5) and math.abs(pl5 - prevPL5) < atr * 0.12
    prevPL5 := pl5

// ─────────────────────────────────────────────────────────────────────
//  STRUCTURE — BOS / CHoCH / MSS (logique par biais de structure)
// ─────────────────────────────────────────────────────────────────────
var float lsh = na
var float lsl = na
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)
if not na(ph)
    lsh := ph
if not na(pl)
    lsl := pl

brkUp = not na(lsh) and close > lsh and close[1] <= lsh
brkDn = not na(lsl) and close < lsl and close[1] >= lsl

var int strBias = 0
chB  = brkUp and strBias <= 0                      // cassure contre-tendance = CHoCH
bosB = brkUp and strBias == 1                      // continuation = BOS
chS  = brkDn and strBias >= 0
bosS = brkDn and strBias == -1
if brkUp
    strBias := 1
if brkDn
    strBias := -1

// Displacement
sBullC   = close > open and (close - open) > atr * 0.5
sBearC   = close < open and (open - close) > atr * 0.5
dispBull = sBullC and sBullC[1] and (close - open) >= (close[1] - open[1]) * 0.75 and atrExpanding
dispBear = sBearC and sBearC[1] and (open - close) >= (open[1] - close[1]) * 0.75 and atrExpanding

// MSS = CHoCH + sweep récent + conviction (displacement ou grosse bougie)
mssB = chB and sweepBull and (dispBull or sBullC)
mssS = chS and sweepBear and (dispBear or sBearC)

sinceStrB = nz(ta.barssince(mssB or chB or bosB), 99999)
sinceStrS = nz(ta.barssince(mssS or chS or bosS), 99999)
structB   = sinceStrB <= structWin
structS   = sinceStrS <= structWin

// ─────────────────────────────────────────────────────────────────────
//  FVG — avec invalidation + expiration (FIX zombies)
// ─────────────────────────────────────────────────────────────────────
bfvg = low  > high[2] and (low - high[2])  > atr * 0.15
sfvg = high < low[2]  and (low[2] - high)  > atr * 0.15

var float bFVGTop = na
var float bFVGBot = na
var int   bFVGBar = na
var float sFVGTop = na
var float sFVGBot = na
var int   sFVGBar = na
if bfvg
    bFVGTop := low
    bFVGBot := high[2]
    bFVGBar := bar_index
if sfvg
    sFVGTop := low[2]
    sFVGBot := high
    sFVGBar := bar_index
// invalidation : gap entièrement traversé, ou trop vieux (150 barres)
if not na(bFVGTop) and (close < bFVGBot - atr * 0.1 or bar_index - bFVGBar > 150)
    bFVGTop := na
    bFVGBot := na
if not na(sFVGTop) and (close > sFVGTop + atr * 0.1 or bar_index - sFVGBar > 150)
    sFVGTop := na
    sFVGBot := na

ibfvg = not na(bFVGTop) and close >= bFVGBot and close <= bFVGTop and not bfvg
isfvg = not na(sFVGTop) and close >= sFVGBot and close <= sFVGTop and not sfvg

// ─────────────────────────────────────────────────────────────────────
//  ORDER BLOCKS + BREAKERS — avec invalidation
// ─────────────────────────────────────────────────────────────────────
impUp = close > open and (close - open) > atr * 0.5
impDn = close < open and (open - close) > atr * 0.5
bob   = close[1] < open[1] and impUp and close > high[1]
sob   = close[1] > open[1] and impDn and close < low[1]

var float lBobHi = na
var float lBobLo = na
var float lSobHi = na
var float lSobLo = na
if bob
    lBobHi := math.max(open[1], close[1])
    lBobLo := math.min(open[1], close[1])
if sob
    lSobHi := math.max(open[1], close[1])
    lSobLo := math.min(open[1], close[1])
// invalidation : OB traversé
if not na(lBobLo) and close < lBobLo - atr * 0.1
    lBobHi := na
    lBobLo := na
if not na(lSobHi) and close > lSobHi + atr * 0.1
    lSobHi := na
    lSobLo := na

brkBull  = not na(lSobHi) and close > lSobHi and strBias == 1
brkBear  = not na(lBobLo) and close < lBobLo and strBias == -1
inBullOB = not na(lBobHi) and close >= lBobLo and close <= lBobHi
inBearOB = not na(lSobHi) and close >= lSobLo and close <= lSobHi

// ─────────────────────────────────────────────────────────────────────
//  OTE / PREMIUM-DISCOUNT / PATTERNS / PO3
// ─────────────────────────────────────────────────────────────────────
swH = ta.highest(high, swingLen * 3)
swL = ta.lowest(low,  swingLen * 3)
swR = swH - swL
inOTEB = swR > 0 and close >= swL + swR * 0.618 and close <= swL + swR * 0.786
inOTES = swR > 0 and close >= swH - swR * 0.786 and close <= swH - swR * 0.618
inEqB  = swR > 0 and close >= swL + swR * 0.382 and close <  swL + swR * 0.618
inEqS  = swR > 0 and close <= swH - swR * 0.382 and close >  swH - swR * 0.618

rngH = ta.highest(high, 100)
rngL = ta.lowest(low,  100)
rngM = (rngH + rngL) / 2
dis  = close < rngM
pre  = close > rngM
dDis = close < rngL + (rngH - rngL) * 0.25
dPre = close > rngH - (rngH - rngL) * 0.25

bCdl = close > open and (close - open) > (high - low) * 0.55
sCdl = close < open and (open - close) > (high - low) * 0.55
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and (close - open) > math.abs(close[1] - open[1])
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and (open - close) > math.abs(close[1] - open[1])
hammBull = wickDn > math.abs(close - open) * 2.5 and wickDn > wickUp * 3.0 and close > open
hammBear = wickUp > math.abs(close - open) * 2.5 and wickUp > wickDn * 3.0 and close < open

// PO3 London (fakeout du range asiatique) + Judas NY (fakeout du range London)
po3B  = inLondon and not na(asianL) and low  < asianL and close > asianL and sslRaw
po3S  = inLondon and not na(asianH) and high > asianH and close < asianH and bslRaw
judB  = inNY and not na(ldnL) and low  < ldnL and close > ldnL and sslRaw
judS  = inNY and not na(ldnH) and high > ldnH and close < ldnH and bslRaw
po3AnyB = po3B or judB
po3AnyS = po3S or judS

// Proximité niveaux clés
nearKeyL = (not na(pdL) and math.abs(close - pdL) < atr * 0.4) or (not na(pwL) and math.abs(close - pwL) < atr * 0.6) or (not na(nyMidnightPx) and math.abs(close - nyMidnightPx) < atr * 0.35) or (not na(asianL) and math.abs(close - asianL) < atr * 0.3)
nearKeyH = (not na(pdH) and math.abs(close - pdH) < atr * 0.4) or (not na(pwH) and math.abs(close - pwH) < atr * 0.6) or (not na(nyMidnightPx) and math.abs(close - nyMidnightPx) < atr * 0.35) or (not na(asianH) and math.abs(close - asianH) < atr * 0.3)

// ─────────────────────────────────────────────────────────────────────
//  SCORE LONG /50
// ─────────────────────────────────────────────────────────────────────
// Confluence momentum (5 modules : EMA-stack, MACD, Ichimoku, RSI, ADX)
momCntL = (bMom ? 1 : 0) + ((macdBull or macdXup) ? 1 : 0) + (ichiBull ? 1 : 0) + (rsiBullZone ? 1 : 0) + (adxBull ? 1 : 0)
momCntS = (sMom ? 1 : 0) + ((macdBear or macdXdn) ? 1 : 0) + (ichiBear ? 1 : 0) + (rsiBearZone ? 1 : 0) + (adxBear ? 1 : 0)

ofScoreL = math.min(4, (ofImbBull ? 2 : 0) + (absBull ? 2 : 0) + (cumDelta > 0 ? 1 : 0) + (cdBullDiv ? 1 : 0))
ofScoreS = math.min(4, (ofImbBear ? 2 : 0) + (absBear ? 2 : 0) + (cumDelta < 0 ? 1 : 0) + (cdBearDiv ? 1 : 0))

vpScoreL = (vpReclaimB ? 3 : vpDiscount ? 2 : 0) + (abovePOC ? 1 : 0)
vpScoreS = (vpReclaimS ? 3 : vpPremium  ? 2 : 0) + (belowPOC ? 1 : 0)

ls = 0
ls += pentaBull ? 8 : quadBull ? 7 : tripleBull ? 5 : (bull1H and bull4H) ? 3 : bull1H ? 1 : 0
ls += sslRaw ? 3 : sweepBull ? 2 : 0
ls += mssB ? 5 : chB ? 3 : bosB ? 2 : structB ? 1 : 0
ls += (bfvg or ibfvg) ? 3 : 0
ls += (bob or inBullOB or brkBull) ? 3 : 0
ls += dDis ? 3 : dis ? 1 : 0
ls += inOTEB ? 2 : inEqB ? 1 : 0
ls += po3AnyB ? 3 : 0
ls += inKillzone ? 1 : 0
ls += vpScoreL
ls += ofScoreL
ls += momCntL >= 4 ? 3 : momCntL == 3 ? 2 : momCntL == 2 ? 1 : 0
ls += (stochXupOS or rbdiv or atBBLow) ? 1 : 0
ls += bullEng ? 2 : hammBull ? 2 : bCdl ? 1 : 0
ls += vSuperSpk ? 2 : vSpk ? 1 : 0
ls += dispBull ? 2 : 0
ls += nearKeyL ? 1 : 0

// ─────────────────────────────────────────────────────────────────────
//  SCORE SHORT /50
// ─────────────────────────────────────────────────────────────────────
ss = 0
ss += pentaBear ? 8 : quadBear ? 7 : tripleBear ? 5 : (bear1H and bear4H) ? 3 : bear1H ? 1 : 0
ss += bslRaw ? 3 : sweepBear ? 2 : 0
ss += mssS ? 5 : chS ? 3 : bosS ? 2 : structS ? 1 : 0
ss += (sfvg or isfvg) ? 3 : 0
ss += (sob or inBearOB or brkBear) ? 3 : 0
ss += dPre ? 3 : pre ? 1 : 0
ss += inOTES ? 2 : inEqS ? 1 : 0
ss += po3AnyS ? 3 : 0
ss += inKillzone ? 1 : 0
ss += vpScoreS
ss += ofScoreS
ss += momCntS >= 4 ? 3 : momCntS == 3 ? 2 : momCntS == 2 ? 1 : 0
ss += (stochXdnOB or rsdiv or atBBHigh) ? 1 : 0
ss += bearEng ? 2 : hammBear ? 2 : sCdl ? 1 : 0
ss += vSuperSpk ? 2 : vSpk ? 1 : 0
ss += dispBear ? 2 : 0
ss += nearKeyH ? 1 : 0

// ─────────────────────────────────────────────────────────────────────
//  GRADES
// ─────────────────────────────────────────────────────────────────────
gr(s) =>
    if s >= 40
        "A++"
    else if s >= 35
        "A+"
    else if s >= 30
        "A"
    else if s >= 25
        "B+"
    else if s >= 20
        "B"
    else
        "C"

grC(s) =>
    if s >= 40
        color.new(#00ffcc, 0)
    else if s >= 35
        color.new(#00e676, 0)
    else if s >= 30
        color.new(#22dd55, 0)
    else if s >= 25
        color.new(#aaee22, 0)
    else if s >= 20
        color.new(#ffdd22, 0)
    else
        color.new(#555577, 0)

// ─────────────────────────────────────────────────────────────────────
//  SL / TP / LEVIER
// ─────────────────────────────────────────────────────────────────────
longSL  = math.min(low, liqL) - atr * atrMult
shortSL = math.max(high, liqH) + atr * atrMult
slL  = math.max(close - longSL,  syminfo.mintick)
slS  = math.max(shortSL - close, syminfo.mintick)
slVL = slL < atr * 3.5 and slL > atr * 0.3
slVS = slS < atr * 3.5 and slS > atr * 0.3

lTP1 = close + slL * rr1
lTP2 = close + slL * rr2
lTP3 = close + slL * rr3
sTP1 = close - slS * rr1
sTP2 = close - slS * rr2
sTP3 = close - slS * rr3

slPL = math.round(slL / close * 100, 3)
slPS = math.round(slS / close * 100, 3)
levL = slPL > 0.001 ? math.round(riskPct / slPL, 1) : 0.0
levS = slPS > 0.001 ? math.round(riskPct / slPS, 1) : 0.0

// ─────────────────────────────────────────────────────────────────────
//  CONDITIONS FINALES
// ─────────────────────────────────────────────────────────────────────
canTrade = inKillzone and not newsBlocked and volFilter and barstate.isconfirmed

longDir  = bull1H and bull4H
longZone = bfvg or ibfvg or bob or inBullOB or brkBull or vpReclaimB
longLoc  = dis or inOTEB or vpDiscount
longFlow = cumDelta > 0 or delta3 > 0
longCore = longDir and sweepBull and structB and longZone and longLoc and longFlow

shortDir  = bear1H and bear4H
shortZone = sfvg or isfvg or sob or inBearOB or brkBear or vpReclaimS
shortLoc  = pre or inOTES or vpPremium
shortFlow = cumDelta < 0 or delta3 < 0
shortCore = shortDir and sweepBear and structS and shortZone and shortLoc and shortFlow

buyS  = canTrade and ls >= minScoreL and longCore  and slVL
sellS = canTrade and ss >= minScoreS and shortCore and slVS

aPPBuy  = buyS  and ls >= 40 and po3AnyB and inOTEB and (bullEng or hammBull or dispBull or ofImbBull)
aPPSell = sellS and ss >= 40 and po3AnyS and inOTES and (bearEng or hammBear or dispBear or ofImbBear)

// ─────────────────────────────────────────────────────────────────────
//  RAISONS (pourquoi le signal est entré)
// ─────────────────────────────────────────────────────────────────────
whyL() =>
    r = pentaBull ? "PENTA·" : quadBull ? "QUAD·" : tripleBull ? "3TF·" : "2TF·"
    r += mssB ? "MSS·" : chB ? "CHoCH·" : bosB ? "BOS·" : structB ? "STR·" : ""
    r += sslRaw ? "SWEEP·" : sweepBull ? "swp·" : ""
    r += po3B ? "PO3·" : judB ? "JUDAS·" : ""
    r += bfvg ? "FVG·" : ibfvg ? "iFVG·" : ""
    r += bob ? "OB·" : brkBull ? "BRKR·" : inBullOB ? "inOB·" : ""
    r += inOTEB ? "OTE·" : ""
    r += dDis ? "D.DISC·" : dis ? "DISC·" : ""
    r += vpReclaimB ? "VAL-RECLAIM·" : vpDiscount ? "VP-DISC·" : ""
    r += ofImbBull ? "OF-IMB·" : ""
    r += absBull ? "ABSORB·" : ""
    r += cdBullDiv ? "ΔDIV·" : ""
    r += dispBull ? "DISP·" : ""
    r += bullEng ? "ENGULF·" : hammBull ? "HAMMER·" : ""
    r += vSuperSpk ? "VOLx2.5·" : vSpk ? "VOLx1.5·" : ""
    r += inLondon ? "LDN" : inNY ? "NY" : ""
    r

whyS() =>
    r = pentaBear ? "PENTA·" : quadBear ? "QUAD·" : tripleBear ? "3TF·" : "2TF·"
    r += mssS ? "MSS·" : chS ? "CHoCH·" : bosS ? "BOS·" : structS ? "STR·" : ""
    r += bslRaw ? "SWEEP·" : sweepBear ? "swp·" : ""
    r += po3S ? "PO3·" : judS ? "JUDAS·" : ""
    r += sfvg ? "FVG·" : isfvg ? "iFVG·" : ""
    r += sob ? "OB·" : brkBear ? "BRKR·" : inBearOB ? "inOB·" : ""
    r += inOTES ? "OTE·" : ""
    r += dPre ? "D.PREM·" : pre ? "PREM·" : ""
    r += vpReclaimS ? "VAH-REJECT·" : vpPremium ? "VP-PREM·" : ""
    r += ofImbBear ? "OF-IMB·" : ""
    r += absBear ? "ABSORB·" : ""
    r += cdBearDiv ? "ΔDIV·" : ""
    r += dispBear ? "DISP·" : ""
    r += bearEng ? "ENGULF·" : hammBear ? "HAMMER·" : ""
    r += vSuperSpk ? "VOLx2.5·" : vSpk ? "VOLx1.5·" : ""
    r += inLondon ? "LDN" : inNY ? "NY" : ""
    r

// ─────────────────────────────────────────────────────────────────────
//  JOURNAL DES SIGNAUX (8 derniers : quand, sens, où, score, pourquoi)
// ─────────────────────────────────────────────────────────────────────
var string[] jrn = array.new_string()
var string lastWhy   = "---"
var string lastInfo  = "---"
var float  lastEntry = na
var float  lastSL    = na
var float  lastT1    = na
var float  lastT2    = na
var float  lastT3    = na
var string lastDir   = "---"

pushJ(txt) =>
    array.unshift(jrn, txt)
    if array.size(jrn) > 8
        array.pop(jrn)

if buyS
    lastWhy   := whyL()
    lastDir   := aPPBuy ? "BUY A++" : "BUY " + gr(ls)
    lastEntry := close
    lastSL    := longSL
    lastT1    := lTP1
    lastT2    := lTP2
    lastT3    := lTP3
    lastInfo  := str.format_time(time, "dd/MM HH:mm", "Europe/Paris")
    pushJ(lastInfo + "  ▲" + (aPPBuy ? "BUY A++ " : "BUY " + gr(ls) + " ") + str.tostring(close, format.mintick) + " [" + str.tostring(ls) + "/50] " + lastWhy)

if sellS
    lastWhy   := whyS()
    lastDir   := aPPSell ? "SELL A++" : "SELL " + gr(ss)
    lastEntry := close
    lastSL    := shortSL
    lastT1    := sTP1
    lastT2    := sTP2
    lastT3    := sTP3
    lastInfo  := str.format_time(time, "dd/MM HH:mm", "Europe/Paris")
    pushJ(lastInfo + "  ▼" + (aPPSell ? "SELL A++ " : "SELL " + gr(ss) + " ") + str.tostring(close, format.mintick) + " [" + str.tostring(ss) + "/50] " + lastWhy)

// ═══════════════════════════════════════════════════════════════════════
//  VISUELS — UNIQUEMENT les signaux (chart 100% clean)
// ═══════════════════════════════════════════════════════════════════════
plotshape(buyS  and not aPPBuy,  style=shape.triangleup,   location=location.belowbar, color=color.new(#00ff88, 0), size=size.large, title="BUY")
plotshape(aPPBuy,                style=shape.triangleup,   location=location.belowbar, color=color.new(#00ffcc, 0), size=size.huge,  title="BUY A++")
plotshape(sellS and not aPPSell, style=shape.triangledown, location=location.abovebar, color=color.new(#ff2222, 0), size=size.large, title="SELL")
plotshape(aPPSell,               style=shape.triangledown, location=location.abovebar, color=color.new(#ff88cc, 0), size=size.huge,  title="SELL A++")

if buyS and showLbl
    label.new(bar_index, low - atr * 1.2,
         (aPPBuy ? "★ BUY " : "▲ BUY ") + gr(ls) + " [" + str.tostring(ls) + "/50]\n" +
         "Entry : " + str.tostring(close, format.mintick) + "\n" +
         "SL    : " + str.tostring(longSL, format.mintick) + " (-" + str.tostring(slPL) + "%)\n" +
         "TP1   : " + str.tostring(lTP1, format.mintick) + " (" + str.tostring(rr1) + "R)\n" +
         "TP2   : " + str.tostring(lTP2, format.mintick) + " (" + str.tostring(rr2) + "R)\n" +
         "TP3   : " + str.tostring(lTP3, format.mintick) + " (" + str.tostring(rr3) + "R)\n" +
         "Risk  : " + str.tostring(riskPct) + "% | x" + str.tostring(levL) + "\n" +
         whyL(),
         style=label.style_label_up, color=color.new(aPPBuy ? #001e33 : #002a1a, 5),
         textcolor=color.new(aPPBuy ? #00ffcc : #00ff88, 0), size=size.normal)

if sellS and showLbl
    label.new(bar_index, high + atr * 1.2,
         (aPPSell ? "★ SELL " : "▼ SELL ") + gr(ss) + " [" + str.tostring(ss) + "/50]\n" +
         "Entry : " + str.tostring(close, format.mintick) + "\n" +
         "SL    : " + str.tostring(shortSL, format.mintick) + " (+" + str.tostring(slPS) + "%)\n" +
         "TP1   : " + str.tostring(sTP1, format.mintick) + " (" + str.tostring(rr1) + "R)\n" +
         "TP2   : " + str.tostring(sTP2, format.mintick) + " (" + str.tostring(rr2) + "R)\n" +
         "TP3   : " + str.tostring(sTP3, format.mintick) + " (" + str.tostring(rr3) + "R)\n" +
         "Risk  : " + str.tostring(riskPct) + "% | x" + str.tostring(levS) + "\n" +
         whyS(),
         style=label.style_label_down, color=color.new(aPPSell ? #2a0018 : #1e0010, 5),
         textcolor=color.new(aPPSell ? #ff88cc : #ff3333, 0), size=size.normal)

// Lignes SL/TP du dernier signal (OFF par défaut pour chart clean)
var line lnSL = na
var line ln1  = na
var line ln2  = na
var line ln3  = na
if (buyS or sellS) and showLines
    if not na(lnSL)
        line.delete(lnSL)
        line.delete(ln1)
        line.delete(ln2)
        line.delete(ln3)
    sl = buyS ? longSL : shortSL
    t1 = buyS ? lTP1 : sTP1
    t2 = buyS ? lTP2 : sTP2
    t3 = buyS ? lTP3 : sTP3
    lnSL := line.new(bar_index, sl, bar_index + 40, sl, color=color.new(#ff3333, 12), width=2, style=line.style_dashed)
    ln1  := line.new(bar_index, t1, bar_index + 40, t1, color=color.new(#00ff88, 15), width=1, style=line.style_dotted)
    ln2  := line.new(bar_index, t2, bar_index + 40, t2, color=color.new(#00ffcc, 15), width=1, style=line.style_dotted)
    ln3  := line.new(bar_index, t3, bar_index + 40, t3, color=color.new(#00ddff, 12), width=2, style=line.style_dotted)

// ═══════════════════════════════════════════════════════════════════════
//  DASHBOARD ULTRA COMPLET
// ═══════════════════════════════════════════════════════════════════════
var table db = table.new(dbRight ? position.top_right : position.top_left, 4, 44, bgcolor=color.new(#04040e, 8), border_color=color.new(#14142a, 60), border_width=1, frame_color=color.new(#2233cc, 40), frame_width=2)

cb  = color.new(#070714, 10)
ch  = color.new(#0d0d24, 0)
cgy = color.new(#555577, 0)
cgn = color.new(#00cc88, 0)
crd = color.new(#ff5555, 0)
cgd = color.new(#ffdd22, 0)
cbl = color.new(#38bdf8, 0)
cpu = color.new(#a78bfa, 0)

dc(c, r, t, bg, tc) =>
    table.cell(db, c, r, t, bgcolor=bg, text_color=tc, text_size=size.tiny)

sec(r, t) =>
    table.cell(db, 0, r, t, bgcolor=ch, text_color=cbl, text_size=size.tiny)
    table.merge_cells(db, 0, r, 3, r)

biasTxt(b, s) => b ? "BULL" : s ? "BEAR" : "—"
biasCol(b, s) => b ? cgn : s ? crd : cgy

if dbOn and barstate.islast
    // ── TITRE + SIGNAL ──
    table.cell(db, 0, 0, "ICT PRO V6 — " + syminfo.ticker + " " + timeframe.period, bgcolor=ch, text_color=color.white, text_size=size.small)
    table.merge_cells(db, 0, 0, 3, 0)
    sigTxt = aPPBuy ? "★ BUY A++ [" + str.tostring(ls) + "/50]" : buyS ? "▲ BUY " + gr(ls) + " [" + str.tostring(ls) + "/50]" : aPPSell ? "★ SELL A++ [" + str.tostring(ss) + "/50]" : sellS ? "▼ SELL " + gr(ss) + " [" + str.tostring(ss) + "/50]" : "ATTENTE  ·  L:" + str.tostring(ls) + "  S:" + str.tostring(ss)
    sigCol = aPPBuy ? color.new(#00ffcc, 0) : buyS ? color.new(#00ff88, 0) : aPPSell ? color.new(#ff88cc, 0) : sellS ? color.new(#ff3333, 0) : cgy
    table.cell(db, 0, 1, sigTxt, bgcolor=ch, text_color=sigCol, text_size=size.normal)
    table.merge_cells(db, 0, 1, 3, 1)

    // ── CONTEXTE ──
    sec(2, "— CONTEXTE —")
    dc(0, 3, "Session", cb, cgy)
    dc(1, 3, inLondon ? "LONDON" : inNY ? "NEW YORK" : inAsian ? "ASIE" : "OFF", cb, inKillzone ? cgn : inAsian ? cgd : crd)
    dc(2, 3, "News", cb, cgy)
    dc(3, 3, newsBlocked ? "BLOQUÉ" : "ds " + newsCountdown(), cb, newsBlocked ? crd : cgn)
    dc(0, 4, "Volatilité", cb, cgy)
    dc(1, 4, vSuperSpk ? "SPIKE x2.5" : vSpk ? "Spike x1.5" : volFilter ? "OK" : "FAIBLE", cb, vSuperSpk ? cgd : volFilter ? cgn : crd)
    dc(2, 4, "ADX", cb, cgy)
    dc(3, 4, str.tostring(math.round(adx, 1)) + (adxBull ? " ↑" : adxBear ? " ↓" : " ·"), cb, adxTrending ? (adxBull ? cgn : adxBear ? crd : cgy) : cgy)
    dc(0, 5, "VWAP", cb, cgy)
    dc(1, 5, close > vwap ? "AU-DESSUS" : "EN-DESSOUS", cb, close > vwap ? cgn : crd)
    dc(2, 5, "Régime", cb, cgy)
    dc(3, 5, adxTrending ? "TREND" : "RANGE", cb, adxTrending ? cbl : cgd)

    // ── BIAIS MULTI-TF ──
    sec(6, "— BIAIS MULTI-TIMEFRAME —")
    dc(0, 7, "1H", cb, cgy)
    dc(1, 7, biasTxt(bull1H, bear1H), cb, biasCol(bull1H, bear1H))
    dc(2, 7, "4H", cb, cgy)
    dc(3, 7, biasTxt(bull4H, bear4H), cb, biasCol(bull4H, bear4H))
    dc(0, 8, "Daily", cb, cgy)
    dc(1, 8, biasTxt(bullD, bearD), cb, biasCol(bullD, bearD))
    dc(2, 8, "Weekly", cb, cgy)
    dc(3, 8, biasTxt(bullW, bearW), cb, biasCol(bullW, bearW))
    dc(0, 9, "Monthly", cb, cgy)
    dc(1, 9, biasTxt(bullM, bearM), cb, biasCol(bullM, bearM))
    alignT = pentaBull ? "PENTA BULL" : pentaBear ? "PENTA BEAR" : quadBull ? "QUAD BULL" : quadBear ? "QUAD BEAR" : tripleBull ? "TRIPLE BULL" : tripleBear ? "TRIPLE BEAR" : "MIXTE"
    dc(2, 9, "Align", cb, cgy)
    dc(3, 9, alignT, cb, (pentaBull or quadBull or tripleBull) ? color.new(#00ffcc, 0) : (pentaBear or quadBear or tripleBear) ? crd : cgy)

    // ── ICT / PRICE ACTION ──
    sec(10, "— ICT · PRICE ACTION —")
    strT = mssB ? "MSS BULL" : mssS ? "MSS BEAR" : chB ? "CHoCH BULL" : chS ? "CHoCH BEAR" : bosB ? "BOS BULL" : bosS ? "BOS BEAR" : strBias == 1 ? "biais haussier" : strBias == -1 ? "biais baissier" : "—"
    dc(0, 11, "Structure", cb, cgy)
    dc(1, 11, strT, cb, (mssB or chB or bosB or strBias == 1) ? cgn : (mssS or chS or bosS or strBias == -1) ? crd : cgy)
    swpT = sslRaw ? "SSL SWEEP!" : bslRaw ? "BSL SWEEP!" : sweepBull ? "SSL il y a " + str.tostring(sinceSSL) + "b" : sweepBear ? "BSL il y a " + str.tostring(sinceBSL) + "b" : "—"
    dc(2, 11, "Sweep", cb, cgy)
    dc(3, 11, swpT, cb, (sslRaw or sweepBull) ? cgn : (bslRaw or sweepBear) ? crd : cgy)
    dc(0, 12, "FVG", cb, cgy)
    dc(1, 12, bfvg ? "BULL frais" : ibfvg ? "BULL actif" : sfvg ? "BEAR frais" : isfvg ? "BEAR actif" : "—", cb, (bfvg or ibfvg) ? cgn : (sfvg or isfvg) ? crd : cgy)
    dc(2, 12, "OB/Breaker", cb, cgy)
    dc(3, 12, bob ? "OB BULL" : brkBull ? "BREAKER B" : inBullOB ? "dans OB B" : sob ? "OB BEAR" : brkBear ? "BREAKER S" : inBearOB ? "dans OB S" : "—", cb, (bob or brkBull or inBullOB) ? cgn : (sob or brkBear or inBearOB) ? crd : cgy)
    dc(0, 13, "PO3/Judas", cb, cgy)
    dc(1, 13, po3B ? "PO3 BULL" : judB ? "JUDAS NY B" : po3S ? "PO3 BEAR" : judS ? "JUDAS NY S" : "—", cb, po3AnyB ? color.new(#00ffcc, 0) : po3AnyS ? color.new(#ff88cc, 0) : cgy)
    dc(2, 13, "OTE Fib", cb, cgy)
    dc(3, 13, inOTEB ? "61-79% BULL" : inOTES ? "61-79% BEAR" : (inEqB or inEqS) ? "EQ 38-62%" : "—", cb, (inOTEB or inOTES) ? cgd : cgy)
    dc(0, 14, "Zone IPDA", cb, cgy)
    dc(1, 14, dDis ? "DEEP DISC" : dis ? "Discount" : dPre ? "DEEP PREM" : pre ? "Premium" : "EQ", cb, dis ? cgn : pre ? crd : cgy)
    dc(2, 14, "EQ pools", cb, cgy)
    dc(3, 14, eqH ? "EQH (liq ↑)" : eqL ? "EQL (liq ↓)" : "—", cb, (eqH or eqL) ? cgd : cgy)
    keyT = nearKeyL ? "support clé" : nearKeyH ? "résistance clé" : "—"
    dc(0, 15, "Niveau clé", cb, cgy)
    dc(1, 15, keyT, cb, nearKeyL ? cgn : nearKeyH ? crd : cgy)
    dc(2, 15, "Asian H/L", cb, cgy)
    dc(3, 15, not na(asianH) ? str.tostring(asianH, format.mintick) + "/" + str.tostring(asianL, format.mintick) : "—", cb, cpu)

    // ── VOLUME PROFILE & ORDER FLOW ──
    sec(16, "— VOLUME PROFILE · ORDER FLOW —")
    dc(0, 17, "POC", cb, cgy)
    dc(1, 17, not na(poc) ? str.tostring(poc, format.mintick) : "—", cb, cpu)
    dc(2, 17, "Px vs POC", cb, cgy)
    dc(3, 17, abovePOC ? "AU-DESSUS" : belowPOC ? "EN-DESSOUS" : "—", cb, abovePOC ? cgn : belowPOC ? crd : cgy)
    dc(0, 18, "VAH", cb, cgy)
    dc(1, 18, not na(vaH) ? str.tostring(vaH, format.mintick) : "—", cb, cpu)
    dc(2, 18, "VAL", cb, cgy)
    dc(3, 18, not na(vaL) ? str.tostring(vaL, format.mintick) : "—", cb, cpu)
    vpT = vpReclaimB ? "RECLAIM VAL!" : vpReclaimS ? "REJET VAH!" : vpDiscount ? "sous VA (disc)" : vpPremium ? "sur VA (prem)" : nearPOC ? "aimant POC" : "dans VA"
    dc(0, 19, "Position VP", cb, cgy)
    dc(1, 19, vpT, cb, vpReclaimB ? cgn : vpReclaimS ? crd : vpDiscount ? cgn : vpPremium ? crd : cgy)
    dc(2, 19, "Delta barre", cb, cgy)
    dc(3, 19, deltaBar > 0 ? "+" + str.tostring(math.round(deltaBar)) : str.tostring(math.round(deltaBar)), cb, deltaBar > 0 ? cgn : deltaBar < 0 ? crd : cgy)
    dc(0, 20, "Delta x3", cb, cgy)
    dc(1, 20, delta3 > 0 ? "ACHETEUR" : delta3 < 0 ? "VENDEUR" : "—", cb, delta3 > 0 ? cgn : delta3 < 0 ? crd : cgy)
    dc(2, 20, "CumΔ " + str.tostring(ofWin) + "b", cb, cgy)
    dc(3, 20, cumDelta > 0 ? "POSITIF" : "NÉGATIF", cb, cumDelta > 0 ? cgn : crd)
    dc(0, 21, "Imbalance", cb, cgy)
    dc(1, 21, ofImbBull ? "ACHAT >60%" : ofImbBear ? "VENTE >60%" : "—", cb, ofImbBull ? cgn : ofImbBear ? crd : cgy)
    dc(2, 21, "Absorption", cb, cgy)
    dc(3, 21, absBull ? "VENDEURS abs." : absBear ? "ACHETEURS abs." : "—", cb, absBull ? cgn : absBear ? crd : cgy)
    dc(0, 22, "Div Δ/prix", cb, cgy)
    dc(1, 22, cdBullDiv ? "BULL DIV" : cdBearDiv ? "BEAR DIV" : "—", cb, cdBullDiv ? cgn : cdBearDiv ? crd : cgy)
    dc(2, 22, "OF momentum", cb, cgy)
    dc(3, 22, ofBull ? "ACHETEUR" : ofBear ? "VENDEUR" : "—", cb, ofBull ? cgn : ofBear ? crd : cgy)

    // ── MOMENTUM ──
    sec(23, "— MOMENTUM —")
    dc(0, 24, "RSI", cb, cgy)
    dc(1, 24, str.tostring(math.round(rsi, 1)) + (rbdiv ? " div+" : rsdiv ? " div-" : ""), cb, rsi > 50 ? cgn : crd)
    dc(2, 24, "StochRSI", cb, cgy)
    dc(3, 24, stochXupOS ? "CROSS ↑ OS" : stochXdnOB ? "CROSS ↓ OB" : str.tostring(math.round(stochK)), cb, stochXupOS ? cgn : stochXdnOB ? crd : cgy)
    dc(0, 25, "MACD", cb, cgy)
    dc(1, 25, macdXup ? "CROSS ↑" : macdXdn ? "CROSS ↓" : macdBull ? "BULL" : macdBear ? "BEAR" : "—", cb, (macdBull or macdXup) ? cgn : (macdBear or macdXdn) ? crd : cgy)
    dc(2, 25, "Ichimoku", cb, cgy)
    dc(3, 25, ichiBull ? "BULL" : ichiBear ? "BEAR" : "nuage", cb, ichiBull ? cgn : ichiBear ? crd : cgy)
    dc(0, 26, "EMA stack", cb, cgy)
    dc(1, 26, bMom ? "BULL" : sMom ? "BEAR" : "—", cb, bMom ? cgn : sMom ? crd : cgy)
    dc(2, 26, "Confluence", cb, cgy)
    dc(3, 26, str.tostring(momCntL) + "/5 B · " + str.tostring(momCntS) + "/5 S", cb, momCntL > momCntS ? cgn : momCntS > momCntL ? crd : cgy)

    // ── SCORES ──
    sec(27, "— SCORES —")
    dc(0, 28, "LONG", cb, cgy)
    dc(1, 28, str.tostring(ls) + "/50  " + gr(ls), cb, grC(ls))
    dc(2, 28, "SHORT", cb, cgy)
    dc(3, 28, str.tostring(ss) + "/50  " + gr(ss), cb, grC(ss))

    // ── PLAN DE TRADE (dernier signal) ──
    sec(29, "— DERNIER SIGNAL · PLAN —")
    dc(0, 30, "Signal", cb, cgy)
    dc(1, 30, lastDir, cb, str.contains(lastDir, "BUY") ? cgn : str.contains(lastDir, "SELL") ? crd : cgy)
    dc(2, 30, "Quand", cb, cgy)
    dc(3, 30, lastInfo, cb, color.white)
    dc(0, 31, "Entrée", cb, cgy)
    dc(1, 31, not na(lastEntry) ? str.tostring(lastEntry, format.mintick) : "—", cb, color.white)
    dc(2, 31, "SL", cb, cgy)
    dc(3, 31, not na(lastSL) ? str.tostring(lastSL, format.mintick) : "—", cb, crd)
    dc(0, 32, "TP1", cb, cgy)
    dc(1, 32, not na(lastT1) ? str.tostring(lastT1, format.mintick) : "—", cb, cgn)
    dc(2, 32, "TP2", cb, cgy)
    dc(3, 32, not na(lastT2) ? str.tostring(lastT2, format.mintick) : "—", cb, cgn)
    dc(0, 33, "TP3", cb, cgy)
    dc(1, 33, not na(lastT3) ? str.tostring(lastT3, format.mintick) : "—", cb, cgn)
    dc(2, 33, "Risk", cb, cgy)
    dc(3, 33, str.tostring(riskPct) + "%/trade", cb, cgd)
    table.cell(db, 0, 34, "POURQUOI : " + lastWhy, bgcolor=cb, text_color=cbl, text_size=size.tiny)
    table.merge_cells(db, 0, 34, 3, 34)

    // ── JOURNAL ──
    sec(35, "— JOURNAL DES SIGNAUX —")
    jn = array.size(jrn)
    for r = 0 to 7
        txt = r < jn ? array.get(jrn, r) : "·"
        tc  = r < jn ? (str.contains(txt, "▲") ? cgn : crd) : color.new(#222233, 0)
        table.cell(db, 0, 36 + r, txt, bgcolor=cb, text_color=tc, text_size=size.tiny)
        table.merge_cells(db, 0, 36 + r, 3, 36 + r)

// ═══════════════════════════════════════════════════════════════════════
//  ALERTES
// ═══════════════════════════════════════════════════════════════════════
alertcondition(aPPBuy,      title="BUY A++",      message="BUY A++ {{ticker}} {{interval}} Entry {{close}}")
alertcondition(aPPSell,     title="SELL A++",     message="SELL A++ {{ticker}} {{interval}} Entry {{close}}")
alertcondition(buyS,        title="BUY V6",       message="BUY {{ticker}} {{interval}} Entry {{close}}")
alertcondition(sellS,       title="SELL V6",      message="SELL {{ticker}} {{interval}} Entry {{close}}")
alertcondition(po3AnyB,     title="PO3/Judas B",  message="PO3/JUDAS BULL {{ticker}} {{interval}}")
alertcondition(po3AnyS,     title="PO3/Judas S",  message="PO3/JUDAS BEAR {{ticker}} {{interval}}")
alertcondition(mssB,        title="MSS Bull",     message="MSS BULL {{ticker}} {{interval}}")
alertcondition(mssS,        title="MSS Bear",     message="MSS BEAR {{ticker}} {{interval}}")
alertcondition(vpReclaimB,  title="VAL Reclaim",  message="VOLUME PROFILE VAL RECLAIM {{ticker}}")
alertcondition(vpReclaimS,  title="VAH Reject",   message="VOLUME PROFILE VAH REJECT {{ticker}}")
alertcondition(absBull,     title="Absorption B", message="ABSORPTION BULL {{ticker}}")
alertcondition(absBear,     title="Absorption S", message="ABSORPTION BEAR {{ticker}}")
alertcondition(cdBullDiv,   title="Delta Div B",  message="DELTA DIVERGENCE BULL {{ticker}}")
alertcondition(cdBearDiv,   title="Delta Div S",  message="DELTA DIVERGENCE BEAR {{ticker}}")
alertcondition(newsBlocked, title="News Block",   message="NEWS {{ticker}} trading suspendu")

// Alerte dynamique avec raisons complètes (webhook-ready)
if buyS
    alert("BUY " + syminfo.ticker + " " + timeframe.period + " @" + str.tostring(close, format.mintick) + " SL:" + str.tostring(longSL, format.mintick) + " TP1:" + str.tostring(lTP1, format.mintick) + " TP2:" + str.tostring(lTP2, format.mintick) + " TP3:" + str.tostring(lTP3, format.mintick) + " score:" + str.tostring(ls) + "/50 " + whyL(), alert.freq_once_per_bar_close)
if sellS
    alert("SELL " + syminfo.ticker + " " + timeframe.period + " @" + str.tostring(close, format.mintick) + " SL:" + str.tostring(shortSL, format.mintick) + " TP1:" + str.tostring(sTP1, format.mintick) + " TP2:" + str.tostring(sTP2, format.mintick) + " TP3:" + str.tostring(sTP3, format.mintick) + " score:" + str.tostring(ss) + "/50 " + whyS(), alert.freq_once_per_bar_close)
