//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  ICT SIGNAL PRO V5 — CLEAN  (Pine Script v6)
//  Graphique 100% propre : UNIQUEMENT les flèches BUY / SELL
//  Sessions actives : London 08h-10h  /  NY 15h30-20h  (heure Paris)
//  Tous les concepts ICT + Ichimoku + Volume Profile + Order Flow
// ═══════════════════════════════════════════════════════════════════════
indicator("ICT SIGNAL PRO V5", overlay=true,
     max_labels_count=0, max_boxes_count=0, max_lines_count=0)

// ───────────────────────────────────────────────────────────────────────
//  INPUTS
// ───────────────────────────────────────────────────────────────────────
grpR = "Risk"
rr1     = input.float(2.0, "TP1 R:R",           group=grpR, minval=0.5, step=0.25)
rr2     = input.float(3.5, "TP2 R:R",           group=grpR, minval=1.0, step=0.25)
rr3     = input.float(5.0, "TP3 R:R",           group=grpR, minval=1.0, step=0.25)
riskPct = input.float(5.0, "Risk % / trade",    group=grpR, minval=0.1, step=0.1)

grpF = "Filtres"
minScoreLong  = input.int(18, "Score MIN Long  /38", group=grpF, minval=8, maxval=38)
minScoreShort = input.int(18, "Score MIN Short /38", group=grpF, minval=8, maxval=38)
htf      = input.timeframe("60",  "HTF1",     group=grpF)
htf2     = input.timeframe("240", "HTF2",     group=grpF)
swingLen = input.int(10, "Swing length",       group=grpF, minval=3, maxval=30)
atrLen   = input.int(14, "ATR length",         group=grpF, minval=5)
atrMult  = input.float(1.5, "SL ATR buffer",   group=grpF, step=0.1, minval=0.5)
minATR   = input.float(0.8, "ATR vol filter",  group=grpF, step=0.05)

grpN = "News"
useNews = input.bool(true,  "Bloquer news +/- X min", group=grpN)
newsMin = input.int(30,     "Minutes",                group=grpN, minval=5, maxval=120)
news1   = input.time(timestamp("05 Jun 2026 12:30 +0000"), "NFP Jun 5",    group=grpN)
news2   = input.time(timestamp("10 Jun 2026 12:30 +0000"), "CPI Jun 10",   group=grpN)
news3   = input.time(timestamp("17 Jun 2026 18:00 +0000"), "FOMC Jun 17",  group=grpN)
news4   = input.time(timestamp("24 Jun 2026 12:30 +0000"), "PCE Jun 24",   group=grpN)
news5   = input.time(timestamp("01 Jul 2026 12:30 +0000"), "NFP Jul 1",    group=grpN)
news6   = input.time(timestamp("08 Jul 2026 12:30 +0000"), "CPI Jul 8",    group=grpN)
news7   = input.time(timestamp("09 Jul 2026 18:00 +0000"), "FOMC Min",     group=grpN)
news8   = input.time(timestamp("29 Jul 2026 18:00 +0000"), "FOMC Jul",     group=grpN)

// ───────────────────────────────────────────────────────────────────────
//  NEWS
// ───────────────────────────────────────────────────────────────────────
nwMs = newsMin * 60000
nn(t) => math.abs(time - t) <= nwMs
newsBlocked = useNews and (nn(news1) or nn(news2) or nn(news3) or nn(news4) or
     nn(news5) or nn(news6) or nn(news7) or nn(news8))

// ───────────────────────────────────────────────────────────────────────
//  SESSIONS  — London 08h-10h  /  NY 15h30-20h
// ───────────────────────────────────────────────────────────────────────
inLondon   = not na(time(timeframe.period, "0800-1000", "Europe/Paris"))
inNY       = not na(time(timeframe.period, "1530-2000", "Europe/Paris"))
inAsian    = not na(time(timeframe.period, "0100-0800", "Europe/Paris"))
inKillzone = inLondon or inNY

var float nyMidnightPx = na
if not na(time(timeframe.period, "0000-0001", "America/New_York"))
    nyMidnightPx := open

// ───────────────────────────────────────────────────────────────────────
//  RANGE ASIATIQUE
// ───────────────────────────────────────────────────────────────────────
var float asianH = na
var float asianL = na
if ta.change(time("D")) != 0
    asianH := na
    asianL := na
if inAsian
    asianH := na(asianH) ? high : math.max(asianH, high)
    asianL := na(asianL) ? low  : math.min(asianL, low)

// ───────────────────────────────────────────────────────────────────────
//  NIVEAUX PRECEDENTS
// ───────────────────────────────────────────────────────────────────────
pdH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
pdL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
pwH = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_off)
pwL = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_off)

// ───────────────────────────────────────────────────────────────────────
//  BIAIS HTF  1H · 4H · D · W · M
// ───────────────────────────────────────────────────────────────────────
h1C    = request.security(syminfo.tickerid, htf,  close,             lookahead=barmerge.lookahead_off)
h1E21  = request.security(syminfo.tickerid, htf,  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
h1E50  = request.security(syminfo.tickerid, htf,  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h1E200 = request.security(syminfo.tickerid, htf,  ta.ema(close,200), lookahead=barmerge.lookahead_off)
h1Rsi  = request.security(syminfo.tickerid, htf,  ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
h4C    = request.security(syminfo.tickerid, htf2, close,             lookahead=barmerge.lookahead_off)
h4E50  = request.security(syminfo.tickerid, htf2, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h4E200 = request.security(syminfo.tickerid, htf2, ta.ema(close,200), lookahead=barmerge.lookahead_off)
dC     = request.security(syminfo.tickerid, "D",  close,             lookahead=barmerge.lookahead_off)
dE21   = request.security(syminfo.tickerid, "D",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
dE50   = request.security(syminfo.tickerid, "D",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
wC     = request.security(syminfo.tickerid, "W",  close,             lookahead=barmerge.lookahead_off)
wE50   = request.security(syminfo.tickerid, "W",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
mC     = request.security(syminfo.tickerid, "M",  close,             lookahead=barmerge.lookahead_off)
mE21   = request.security(syminfo.tickerid, "M",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)

bull1H  = h1C > h1E21  and h1E21 > h1E50  and h1C > h1E200 and h1Rsi > 50
bear1H  = h1C < h1E21  and h1E21 < h1E50  and h1C < h1E200 and h1Rsi < 50
bull4H  = h4C > h4E50  and h4C > h4E200
bear4H  = h4C < h4E50  and h4C < h4E200
bullD   = dC  > dE21   and dE21  > dE50
bearD   = dC  < dE21   and dE21  < dE50
bullW   = wC  > wE50
bearW   = wC  < wE50
bullM   = mC  > mE21
bearM   = mC  < mE21

tripleBull = bull1H and bull4H and bullD
tripleBear = bear1H and bear4H and bearD
quadBull   = tripleBull and bullW
quadBear   = tripleBear and bearW
pentaBull  = quadBull and bullM
pentaBear  = quadBear and bearM

// ───────────────────────────────────────────────────────────────────────
//  ATR
// ───────────────────────────────────────────────────────────────────────
atr          = ta.atr(atrLen)
atrAvg       = ta.sma(atr, 50)
volFilter    = atr >= atrAvg * minATR
atrExpanding = atr > atr[1] and atr[1] > atr[2]

// ───────────────────────────────────────────────────────────────────────
//  ICHIMOKU
// ───────────────────────────────────────────────────────────────────────
ichiT  = (ta.highest(high, 9)  + ta.lowest(low, 9))  / 2
ichiK  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
ichiA  = (ichiT + ichiK) / 2
ichiB  = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2
cTop   = math.max(ichiA[26], ichiB[26])
cBot   = math.min(ichiA[26], ichiB[26])
ichiBull = close > cTop and ichiT > ichiK
ichiBear = close < cBot and ichiT < ichiK

// ───────────────────────────────────────────────────────────────────────
//  BOLLINGER BANDS
// ───────────────────────────────────────────────────────────────────────
bbMid    = ta.sma(close, 20)
bbDev    = ta.stdev(close, 20)
bbUpper  = bbMid + bbDev * 2.0
bbLower  = bbMid - bbDev * 2.0
atBBLow  = close <= bbLower * 1.002 and bull1H
atBBHigh = close >= bbUpper * 0.998 and bear1H

// ───────────────────────────────────────────────────────────────────────
//  VOLUME + ORDER FLOW
// ───────────────────────────────────────────────────────────────────────
volAvg    = ta.sma(volume, 20)
vSpk      = volume > volAvg * 1.5
vSuperSpk = volume > volAvg * 2.5
deltaBar  = close > open ? volume : close < open ? -volume : 0
cumDelta  = ta.cum(deltaBar)
cdEma     = ta.ema(cumDelta, 21)
cdBullDiv = close < close[5] and cumDelta > cumDelta[5]
cdBearDiv = close > close[5] and cumDelta < cumDelta[5]
ofBull    = ta.ema(deltaBar, 5) > 0 and close > open
ofBear    = ta.ema(deltaBar, 5) < 0 and close < open

// ───────────────────────────────────────────────────────────────────────
//  VOLUME PROFILE (VPOC approx)
// ───────────────────────────────────────────────────────────────────────
vpocLen = 20
var float vpoc = na
if barstate.isconfirmed
    mx  = 0.0
    tmp = close
    for i = 0 to vpocLen - 1
        if volume[i] > mx
            mx  := volume[i]
            tmp := close[i]
    vpoc := tmp
aboveVPOC = not na(vpoc) and close > vpoc
belowVPOC = not na(vpoc) and close < vpoc

// ───────────────────────────────────────────────────────────────────────
//  INDICATEURS
// ───────────────────────────────────────────────────────────────────────
e8   = ta.ema(close, 8)
e13  = ta.ema(close, 13)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
vwap = ta.vwap(close)
bMom = close > e21 and e8 > e21 and e13 > e21 and close > vwap and e21 > e50
sMom = close < e21 and e8 < e21 and e13 < e21 and close < vwap and e21 < e50

rsi         = ta.rsi(close, 14)
stochK      = ta.stoch(rsi, rsi, rsi, 14)
stochD      = ta.ema(stochK, 3)
rsiBullZone = rsi > 45 and rsi < 72
rsiBearZone = rsi < 55 and rsi > 28
rbdiv       = rsi < 40 and close < close[5] and rsi > rsi[5]
rsdiv       = rsi > 60 and close > close[5] and rsi < rsi[5]
stochXupOS  = ta.crossover(stochK, stochD) and stochK < 30
stochXdnOB  = ta.crossunder(stochK, stochD) and stochK > 70

[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
macdBull = macdL > macdS and macdH > 0 and macdH > macdH[1]
macdBear = macdL < macdS and macdH < 0 and macdH < macdH[1]
macdXup  = ta.crossover(macdL, macdS) and macdL < 0
macdXdn  = ta.crossunder(macdL, macdS) and macdL > 0

// ───────────────────────────────────────────────────────────────────────
//  LIQUIDITE  SSL/BSL + EQH/EQL
// ───────────────────────────────────────────────────────────────────────
liqH = ta.highest(high[1], swingLen)
liqL = ta.lowest(low[1],   swingLen)

wickDn = math.min(open, close) - low
wickUp = high - math.max(open, close)

sslStrong = low < liqL and close > liqL and wickDn > atr * 0.4 and close > open
bslStrong = high > liqH and close < liqH and wickUp > atr * 0.4 and close < open

ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow(low,   5, 5)
var float prevPH5 = na
var float prevPL5 = na
if not na(ph5)
    prevPH5 := ph5
if not na(pl5)
    prevPL5 := pl5
eqH = not na(ph5) and not na(prevPH5) and ph5 != prevPH5 and math.abs(ph5 - prevPH5) < atr * 0.15
eqL = not na(pl5) and not na(prevPL5) and pl5 != prevPL5 and math.abs(pl5 - prevPL5) < atr * 0.15

// ───────────────────────────────────────────────────────────────────────
//  STRUCTURE  BOS / CHoCH / MSS
// ───────────────────────────────────────────────────────────────────────
var float lsh = na
var float lsl = na
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)
if not na(ph)
    lsh := ph
if not na(pl)
    lsl := pl

bosB = not na(lsh) and close > lsh and close[1] <= lsh and bull1H
bosS = not na(lsl) and close < lsl and close[1] >= lsl and bear1H
chB  = not na(lsh) and sslStrong[1] and close > lsh and close[1] <= lsh
chS  = not na(lsl) and bslStrong[1] and close < lsl and close[1] >= lsl
mssB = sslStrong and chB
mssS = bslStrong and chS

var int strBias = 0
if mssB or chB
    strBias := 1
if mssS or chS
    strBias := -1

// ───────────────────────────────────────────────────────────────────────
//  DISPLACEMENT
// ───────────────────────────────────────────────────────────────────────
sBull = close > open and (close - open) > atr * 0.5
sBear = close < open and (open - close) > atr * 0.5
dispBull = sBull and sBull[1] and (close - open) >= (close[1] - open[1]) * 0.75 and atrExpanding
dispBear = sBear and sBear[1] and (open - close) >= (open[1] - close[1]) * 0.75 and atrExpanding

// ───────────────────────────────────────────────────────────────────────
//  FAIR VALUE GAP
// ───────────────────────────────────────────────────────────────────────
bfvg = low  > high[2] and (low  - high[2]) > atr * 0.15
sfvg = high < low[2]  and (low[2] - high)  > atr * 0.15

var float bFVGTop = na
var float bFVGBot = na
var float sFVGTop = na
var float sFVGBot = na
if bfvg
    bFVGTop := low
    bFVGBot := high[2]
if sfvg
    sFVGTop := low[2]
    sFVGBot := high
ibfvg = not na(bFVGTop) and close >= bFVGBot and close <= bFVGTop and not bfvg
isfvg = not na(sFVGTop) and close >= sFVGBot and close <= sFVGTop and not sfvg

// ───────────────────────────────────────────────────────────────────────
//  ORDER BLOCKS + BREAKER BLOCKS
// ───────────────────────────────────────────────────────────────────────
impUp = close > open and (close - open) > atr * 0.5
impDn = close < open and (open - close) > atr * 0.5
bob   = close[1] < open[1] and impUp and close > high[1]
sob   = close[1] > open[1] and impDn and close < low[1]
obHi  = math.max(open[1], close[1])
obLo  = math.min(open[1], close[1])
inBullOB = close >= obLo and close <= obHi and bull1H
inBearOB = close >= obLo and close <= obHi and bear1H

var float lBobHi = na
var float lBobLo = na
var float lSobHi = na
var float lSobLo = na
if bob
    lBobHi := math.max(open[1], close[1])
    lBobLo := math.min(open[1], close[1])
if sob
    lSobHi := math.max(open[1], close[1])
    lSobLo := math.min(open[1], close[1])

brkBull = not na(lSobHi) and close > lSobHi and strBias == 1
brkBear = not na(lBobLo) and close < lBobLo  and strBias == -1

// ───────────────────────────────────────────────────────────────────────
//  OTE  Fibonacci 61.8% - 78.6%
// ───────────────────────────────────────────────────────────────────────
swH    = ta.highest(high, swingLen * 3)
swL    = ta.lowest(low,   swingLen * 3)
swR    = swH - swL
inOTEB = close >= swL + swR * 0.618 and close <= swL + swR * 0.786 and bull1H
inOTES = close >= swH - swR * 0.786 and close <= swH - swR * 0.618 and bear1H
inEqB  = close >= swL + swR * 0.382 and close <= swL + swR * 0.618
inEqS  = close >= swH - swR * 0.618 and close <= swH - swR * 0.382

// ───────────────────────────────────────────────────────────────────────
//  PREMIUM / DISCOUNT  IPDA
// ───────────────────────────────────────────────────────────────────────
rngH   = ta.highest(high, 100)
rngL   = ta.lowest(low,   100)
rngM   = (rngH + rngL) / 2
dis    = close < rngM
pre    = close > rngM
dDis   = close < rngL + (rngH - rngL) * 0.25
dPre   = close > rngH - (rngH - rngL) * 0.25

// ───────────────────────────────────────────────────────────────────────
//  PATTERNS CHANDELIER
// ───────────────────────────────────────────────────────────────────────
bCdl = close > open and (close - open) > (high - low) * 0.55
sCdl = close < open and (open - close) > (high - low) * 0.55

bullEng = close > open and close[1] < open[1] and
     close >= open[1] and open <= close[1] and
     (close - open) > math.abs(close[1] - open[1])
bearEng = close < open and close[1] > open[1] and
     close <= open[1] and open >= close[1] and
     (open - close) > math.abs(close[1] - open[1])

hammBull = wickDn > math.abs(close - open) * 2.5 and wickDn > wickUp * 3.0 and close > open
hammBear = wickUp > math.abs(close - open) * 2.5 and wickUp > wickDn * 3.0 and close < open

// ───────────────────────────────────────────────────────────────────────
//  POWER OF 3
// ───────────────────────────────────────────────────────────────────────
po3B = inLondon and not na(asianL) and low < asianL and close > asianL and sslStrong and bull1H
po3S = inLondon and not na(asianH) and high > asianH and close < asianH and bslStrong and bear1H

// ───────────────────────────────────────────────────────────────────────
//  SCORE LONG  /38
// ───────────────────────────────────────────────────────────────────────
ls = 0
ls := ls + (pentaBull ? 8 : quadBull ? 7 : tripleBull ? 5 : (bull1H and bull4H) ? 3 : bull1H ? 1 : 0)
ls := ls + (bullD ? 2 : 0)
ls := ls + (bullW ? 2 : 0)
ls := ls + (bullM ? 2 : 0)
ls := ls + (sslStrong ? 4 : 0)
ls := ls + (mssB ? 5 : chB ? 3 : bosB ? 1 : 0)
ls := ls + ((bfvg or ibfvg) ? 3 : 0)
ls := ls + ((bob or inBullOB or brkBull) ? 3 : 0)
ls := ls + (dDis ? 4 : dis ? 2 : 0)
ls := ls + (inOTEB ? 3 : inEqB ? 1 : 0)
ls := ls + (po3B ? 3 : 0)
ls := ls + (inKillzone ? 2 : 0)
ls := ls + (ichiBull ? 3 : 0)
ls := ls + (atBBLow ? 2 : 0)
ls := ls + (aboveVPOC ? 1 : 0)
ls := ls + (ofBull ? 1 : 0)
ls := ls + (cdBullDiv ? 1 : 0)
ls := ls + (bMom ? 2 : 0)
ls := ls + (rsiBullZone ? 1 : 0)
ls := ls + (rbdiv ? 1 : 0)
ls := ls + (stochXupOS ? 2 : 0)
ls := ls + ((macdBull or macdXup) ? 2 : 0)
ls := ls + (bullEng ? 3 : hammBull ? 2 : bCdl ? 1 : 0)
ls := ls + (vSuperSpk ? 3 : vSpk ? 2 : 0)
ls := ls + (dispBull ? 2 : 0)
ls := ls + ((not na(pdL) and math.abs(close - pdL) < atr * 0.4 or
             not na(pwL) and math.abs(close - pwL) < atr * 0.6) ? 2 : 0)
ls := ls + (eqL ? 1 : 0)

// ───────────────────────────────────────────────────────────────────────
//  SCORE SHORT  /38
// ───────────────────────────────────────────────────────────────────────
ss = 0
ss := ss + (pentaBear ? 8 : quadBear ? 7 : tripleBear ? 5 : (bear1H and bear4H) ? 3 : bear1H ? 1 : 0)
ss := ss + (bearD ? 2 : 0)
ss := ss + (bearW ? 2 : 0)
ss := ss + (bearM ? 2 : 0)
ss := ss + (bslStrong ? 4 : 0)
ss := ss + (mssS ? 5 : chS ? 3 : bosS ? 1 : 0)
ss := ss + ((sfvg or isfvg) ? 3 : 0)
ss := ss + ((sob or inBearOB or brkBear) ? 3 : 0)
ss := ss + (dPre ? 4 : pre ? 2 : 0)
ss := ss + (inOTES ? 3 : inEqS ? 1 : 0)
ss := ss + (po3S ? 3 : 0)
ss := ss + (inKillzone ? 2 : 0)
ss := ss + (ichiBear ? 3 : 0)
ss := ss + (atBBHigh ? 2 : 0)
ss := ss + (belowVPOC ? 1 : 0)
ss := ss + (ofBear ? 1 : 0)
ss := ss + (cdBearDiv ? 1 : 0)
ss := ss + (sMom ? 2 : 0)
ss := ss + (rsiBearZone ? 1 : 0)
ss := ss + (rsdiv ? 1 : 0)
ss := ss + (stochXdnOB ? 2 : 0)
ss := ss + ((macdBear or macdXdn) ? 2 : 0)
ss := ss + (bearEng ? 3 : hammBear ? 2 : sCdl ? 1 : 0)
ss := ss + (vSuperSpk ? 3 : vSpk ? 2 : 0)
ss := ss + (dispBear ? 2 : 0)
ss := ss + ((not na(pdH) and math.abs(close - pdH) < atr * 0.4 or
             not na(pwH) and math.abs(close - pwH) < atr * 0.6) ? 2 : 0)
ss := ss + (eqH ? 1 : 0)

// ───────────────────────────────────────────────────────────────────────
//  GRADE
// ───────────────────────────────────────────────────────────────────────
gr(s) =>
    s >= 32 ? "A++" : s >= 28 ? "A+" : s >= 24 ? "A" :
     s >= 20 ? "B+"  : s >= 16 ? "B"  : "C"

grC(s) =>
    s >= 32 ? color.new(#00ffcc, 0) :
     s >= 28 ? color.new(#00e676, 0) :
     s >= 24 ? color.new(#22dd55, 0) :
     s >= 20 ? color.new(#aaee22, 0) :
     s >= 16 ? color.new(#ffdd22, 0) : color.gray

// ───────────────────────────────────────────────────────────────────────
//  SL / TP
// ───────────────────────────────────────────────────────────────────────
longSL  = math.min(low, liqL) - atr * atrMult
shortSL = math.max(high, liqH) + atr * atrMult
slL     = math.max(close - longSL,  syminfo.mintick)
slS     = math.max(shortSL - close, syminfo.mintick)
slVL    = slL < atr * 5.5 and slL > atr * 0.3
slVS    = slS < atr * 5.5 and slS > atr * 0.3

lTP1 = close + slL * rr1
lTP2 = close + slL * rr2
lTP3 = close + slL * rr3
sTP1 = close - slS * rr1
sTP2 = close - slS * rr2
sTP3 = close - slS * rr3

slPL = math.round(slL / close * 100, 3)
slPS = math.round(slS / close * 100, 3)
levL = slPL > 0.001 ? math.round(riskPct / slPL, 1) : 0.0
levS = slPS > 0.001 ? math.round(riskPct / slPS, 1) : 0.0

// ───────────────────────────────────────────────────────────────────────
//  CONDITIONS FINALES
//  Signal uniquement pendant London 08-10h ou NY 15h30-20h
// ───────────────────────────────────────────────────────────────────────
canTrade = inKillzone and not newsBlocked and volFilter

longCore = (tripleBull or quadBull or pentaBull or (bull1H and bull4H)) and
     sslStrong and (mssB or chB or po3B) and
     (bfvg or ibfvg or bob or brkBull) and dis

shortCore = (tripleBear or quadBear or pentaBear or (bear1H and bear4H)) and
     bslStrong and (mssS or chS or po3S) and
     (sfvg or isfvg or sob or brkBear) and pre

buyS  = canTrade and ls >= minScoreLong  and longCore  and slVL
sellS = canTrade and ss >= minScoreShort and shortCore and slVS

aPPBuy  = buyS  and ls >= 28 and po3B and inOTEB and (bullEng or hammBull or dispBull)
aPPSell = sellS and ss >= 28 and po3S and inOTES and (bearEng or hammBear or dispBear)

// ───────────────────────────────────────────────────────────────────────
//  POURQUOI (raisons du signal)
// ───────────────────────────────────────────────────────────────────────
whyL() =>
    r = pentaBull ? "PENTA|" : quadBull ? "QUAD|" : tripleBull ? "TRIPLE|" : ""
    r := r + (mssB ? "MSS|"  : chB  ? "CHoCH|"  : bosB ? "BOS|"  : "")
    r := r + (po3B  ? "PO3|"  : "")
    r := r + (bfvg  ? "FVG|"  : ibfvg ? "iFVG|" : "")
    r := r + (bob   ? "OB|"   : brkBull ? "BRKR|" : "")
    r := r + (inOTEB ? "OTE|" : "")
    r := r + (ichiBull ? "ICHI|" : "")
    r := r + (atBBLow  ? "BB|"  : "")
    r := r + (dispBull ? "DISP|" : "")
    r := r + (bullEng  ? "ENG|"  : hammBull ? "HAMM|" : "")
    r := r + (vSuperSpk ? "VXX|" : vSpk ? "VX|" : "")
    r := r + (cdBullDiv ? "dDEL|" : "")
    r

whyS() =>
    r = pentaBear ? "PENTA|" : quadBear ? "QUAD|" : tripleBear ? "TRIPLE|" : ""
    r := r + (mssS ? "MSS|"  : chS  ? "CHoCH|"  : bosS ? "BOS|"  : "")
    r := r + (po3S  ? "PO3|"  : "")
    r := r + (sfvg  ? "FVG|"  : isfvg ? "iFVG|" : "")
    r := r + (sob   ? "OB|"   : brkBear ? "BRKR|" : "")
    r := r + (inOTES ? "OTE|" : "")
    r := r + (ichiBear ? "ICHI|" : "")
    r := r + (atBBHigh ? "BB|"  : "")
    r := r + (dispBear ? "DISP|" : "")
    r := r + (bearEng  ? "ENG|"  : hammBear ? "HAMM|" : "")
    r := r + (vSuperSpk ? "VXX|" : vSpk ? "VX|" : "")
    r := r + (cdBearDiv ? "dDEL|" : "")
    r

// ═══════════════════════════════════════════════════════════════════════
//  VISUELS — UNIQUEMENT BUY / SELL  (rien d'autre sur le graphique)
// ═══════════════════════════════════════════════════════════════════════
plotshape(buyS and not aPPBuy,
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00ff88, 0), size=size.large, title="BUY")

plotshape(aPPBuy,
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00ffcc, 0), size=size.huge, title="BUY A++")

plotshape(sellS and not aPPSell,
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#ff2222, 0), size=size.large, title="SELL")

plotshape(aPPSell,
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#ff88cc, 0), size=size.huge, title="SELL A++")

// ═══════════════════════════════════════════════════════════════════════
//  MINI DASHBOARD  — 5 lignes, taille tiny, discret
// ═══════════════════════════════════════════════════════════════════════
var table db = table.new(position.top_right, 2, 5,
     bgcolor=color.new(#000008, 85),
     border_color=color.new(#ffffff, 8),
     border_width=1,
     frame_color=color.new(#2233cc, 25),
     frame_width=1)

dc(c, r, t, bg, tc) =>
    table.cell(db, c, r, t,
         bgcolor=bg, text_color=tc,
         text_size=size.tiny)

cb = color.new(#000008, 85)
ch = color.new(#04041a, 82)

if barstate.islast
    // Ligne 0 : session + news
    dc(0, 0, inLondon ? "LON 08-10" : inNY ? "NY 15h30" : "OFF", cb,
         (inLondon or inNY) ? color.green : color.new(#444466, 0))
    dc(1, 0, newsBlocked ? "NEWS" : str.tostring(ls) + "L " + str.tostring(ss) + "S",
         cb, newsBlocked ? color.red : color.new(#666688, 0))

    // Ligne 1 : alignement
    dc(0, 1, "Align", cb, color.new(#555577, 0))
    dc(1, 1, pentaBull ? "PENTA B" : pentaBear ? "PENTA S" :
         quadBull  ? "QUAD B"  : quadBear  ? "QUAD S"  :
         tripleBull ? "3x B"   : tripleBear ? "3x S"   : "mix",
         cb, (pentaBull or quadBull or tripleBull) ? color.new(#00cc88, 0) :
         (pentaBear or quadBear or tripleBear) ? color.new(#ff5555, 0) : color.new(#555577, 0))

    // Ligne 2 : structure + zone
    dc(0, 2, mssB ? "MSS B" : mssS ? "MSS S" : chB ? "CHoCH B" :
         chS ? "CHoCH S" : bosB ? "BOS B" : bosS ? "BOS S" : "struct",
         cb, (mssB or chB or bosB) ? color.green : (mssS or chS or bosS) ? color.red : color.new(#444466, 0))
    dc(1, 2, dDis ? "D.DIS" : dis ? "DIS" : dPre ? "D.PRE" : pre ? "PRE" : "eq",
         cb, dis ? color.new(#00cc66, 0) : pre ? color.new(#ff5555, 0) : color.new(#444466, 0))

    // Ligne 3 : SIGNAL principal
    dc(0, 3, "SIGNAL", ch, color.new(#888899, 0))
    dc(1, 3, aPPBuy  ? "BUY A++" :
         buyS    ? "BUY "  + gr(ls) :
         aPPSell ? "SELL A++" :
         sellS   ? "SELL " + gr(ss) : "wait",
         ch,
         aPPBuy  ? color.new(#00ffcc, 0) : buyS   ? color.new(#00ff88, 0) :
         aPPSell ? color.new(#ff88cc, 0) : sellS  ? color.new(#ff3333, 0) :
         color.new(#444455, 0))

    // Ligne 4 : raison quand signal actif
    dc(0, 4, "why", cb, color.new(#444455, 0))
    dc(1, 4, buyS  ? whyL() :
         sellS ? whyS() : "---",
         cb, buyS ? color.new(#00cc66, 0) : sellS ? color.new(#ff4444, 0) : color.new(#333344, 0))

// ═══════════════════════════════════════════════════════════════════════
//  ALERTES  (const string - requis Pine v6)
// ═══════════════════════════════════════════════════════════════════════
alertcondition(aPPBuy,   title="BUY A++",        message="BUY A++ {{ticker}} {{interval}} Entry {{close}}")
alertcondition(aPPSell,  title="SELL A++",       message="SELL A++ {{ticker}} {{interval}} Entry {{close}}")
alertcondition(buyS,     title="BUY ICT V5",     message="BUY {{ticker}} {{interval}} Entry {{close}}")
alertcondition(sellS,    title="SELL ICT V5",    message="SELL {{ticker}} {{interval}} Entry {{close}}")
alertcondition(po3B,     title="PO3 Bull",       message="POWER OF 3 BULL {{ticker}} {{interval}}")
alertcondition(po3S,     title="PO3 Bear",       message="POWER OF 3 BEAR {{ticker}} {{interval}}")
alertcondition(mssB,     title="MSS Bull",       message="MSS BULL {{ticker}} {{interval}}")
alertcondition(mssS,     title="MSS Bear",       message="MSS BEAR {{ticker}} {{interval}}")
alertcondition(chB,      title="CHoCH Bull",     message="CHOCH BULL {{ticker}} {{interval}}")
alertcondition(chS,      title="CHoCH Bear",     message="CHOCH BEAR {{ticker}} {{interval}}")
alertcondition(dispBull, title="Displacement Up",message="DISPLACEMENT BULL {{ticker}}")
alertcondition(dispBear, title="Displacement Dn",message="DISPLACEMENT BEAR {{ticker}}")
alertcondition(brkBull,  title="Breaker Bull",   message="BREAKER BULL {{ticker}}")
alertcondition(brkBear,  title="Breaker Bear",   message="BREAKER BEAR {{ticker}}")
alertcondition(eqH,      title="EQH Pool",       message="EQUAL HIGHS {{ticker}}")
alertcondition(eqL,      title="EQL Pool",       message="EQUAL LOWS {{ticker}}")
alertcondition(newsBlocked, title="News Block",  message="NEWS BLOCK {{ticker}} trading suspendu")
