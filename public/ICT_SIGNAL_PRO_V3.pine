//@version=6
// =============================================================================
//  ICT SIGNAL PRO V3 - ULTRA  (Pine Script v6)
//  EURUSD - NASDAQ - DOW JONES - S&P500
//  London 08h00-11h00 Paris  /  NY 15h30-20h00 Paris
//  Concepts : MSS - CHoCH - BOS - FVG - OB - Breaker - PO3 - OTE
//  Cum. Delta (carnet d ordres) - StochRSI - Displacement
// =============================================================================
indicator("ICT SIGNAL PRO V3 - ULTRA", overlay=true,
     max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// --- RISK ---
grpR    = "Risk Management"
rr1     = input.float(2.0, "TP1 R:R",         group=grpR, minval=0.5, step=0.25)
rr2     = input.float(3.5, "TP2 R:R",         group=grpR, minval=1.0, step=0.25)
rr3     = input.float(5.0, "TP3 R:R",         group=grpR, minval=1.0, step=0.25)
riskPct = input.float(5.0, "Risk pct / trade", group=grpR, minval=0.1, step=0.1)

// --- FILTRES ---
grpF          = "Filtres ICT"
minScoreLong  = input.int(16,  "Score MIN Long  max 30",  group=grpF, minval=8, maxval=30)
minScoreShort = input.int(16,  "Score MIN Short max 30",  group=grpF, minval=8, maxval=30)
htf      = input.timeframe("60",  "HTF1 Bias TF",  group=grpF)
htf2     = input.timeframe("240", "HTF2 Bias TF",  group=grpF)
swingLen = input.int(10, "Swing pivot length",      group=grpF, minval=3, maxval=30)
atrLen   = input.int(14, "ATR length",              group=grpF, minval=5)
atrMult  = input.float(1.5, "SL ATR buffer",        group=grpF, step=0.1, minval=0.5)
minATR   = input.float(0.8, "ATR vol filter x avg", group=grpF, step=0.05, minval=0.1)

// --- AFFICHAGE ---
grpD      = "Affichage"
showFVG   = input.bool(true, "FVG boxes",              group=grpD)
showOB    = input.bool(true, "Order Block boxes",       group=grpD)
showLvls  = input.bool(true, "PDH PDL PWH PWL PMH PML", group=grpD)
showVwap  = input.bool(true, "VWAP + Bandes",          group=grpD)
showEMAs  = input.bool(true, "EMAs 8/21/50/200",       group=grpD)
showAsian = input.bool(true, "Range Asiatique H/L",    group=grpD)

// --- SESSIONS ---
grpS      = "Sessions heure Paris"
useLondon = input.bool(true, "London  08h00-11h00", group=grpS)
useNY     = input.bool(true, "NY      15h30-20h00", group=grpS)
useAsian  = input.bool(true, "Asian   01h00-08h00", group=grpS)

// --- ACTUALITES ---
grpN    = "Actualites Macro"
useNews = input.bool(true, "Bloquer trading +/- X min", group=grpN)
newsMin = input.int(30, "Minutes avant apres",          group=grpN, minval=5, maxval=120)
news1   = input.time(timestamp("05 Jun 2026 12:30 +0000"), "NFP Jun 5",    group=grpN)
news2   = input.time(timestamp("10 Jun 2026 12:30 +0000"), "CPI Jun 10",   group=grpN)
news3   = input.time(timestamp("17 Jun 2026 18:00 +0000"), "FOMC Jun 17",  group=grpN)
news4   = input.time(timestamp("24 Jun 2026 12:30 +0000"), "PCE Jun 24",   group=grpN)
news5   = input.time(timestamp("01 Jul 2026 12:30 +0000"), "NFP Jul 1",    group=grpN)
news6   = input.time(timestamp("08 Jul 2026 12:30 +0000"), "CPI Jul 8",    group=grpN)
news7   = input.time(timestamp("09 Jul 2026 18:00 +0000"), "FOMC Minutes", group=grpN)
news8   = input.time(timestamp("29 Jul 2026 18:00 +0000"), "FOMC Jul 29",  group=grpN)

// =============================================================================
//  NEWS FILTER
// =============================================================================
nwMs = newsMin * 60000
nn(t) => math.abs(time - t) <= nwMs
newsBlocked = useNews and (nn(news1) or nn(news2) or nn(news3) or nn(news4) or
     nn(news5) or nn(news6) or nn(news7) or nn(news8))

// =============================================================================
//  SESSIONS
// =============================================================================
inLondon   = useLondon and not na(time(timeframe.period, "0800-1100", "Europe/Paris"))
inNY       = useNY     and not na(time(timeframe.period, "1530-2000", "Europe/Paris"))
inAsian    = useAsian  and not na(time(timeframe.period, "0100-0800", "Europe/Paris"))
inKillzone = inLondon or inNY

var float londonOpenPx = na
var float nyOpenPx     = na
var float nyMidnightPx = na

isLondonOpen = not na(time(timeframe.period, "0800-0801", "Europe/Paris"))
isNYOpen     = not na(time(timeframe.period, "1530-1531", "Europe/Paris"))
isNYMidnight = not na(time(timeframe.period, "0000-0001", "America/New_York"))

if isLondonOpen
    londonOpenPx := open
if isNYOpen
    nyOpenPx := open
if isNYMidnight
    nyMidnightPx := open

// =============================================================================
//  RANGE ASIATIQUE
// =============================================================================
newDay = ta.change(time("D")) != 0

var float asianH = na
var float asianL = na

if newDay
    asianH := na
    asianL := na

if inAsian
    asianH := na(asianH) ? high : math.max(asianH, high)
    asianL := na(asianL) ? low  : math.min(asianL, low)

// =============================================================================
//  NIVEAUX PRECEDENTS
// =============================================================================
pdH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
pdL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
pwH = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_off)
pwL = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_off)
pmH = request.security(syminfo.tickerid, "M", high[1],  lookahead=barmerge.lookahead_off)
pmL = request.security(syminfo.tickerid, "M", low[1],   lookahead=barmerge.lookahead_off)

// =============================================================================
//  BIAIS HTF
// =============================================================================
h1C    = request.security(syminfo.tickerid, htf,  close,             lookahead=barmerge.lookahead_off)
h1E21  = request.security(syminfo.tickerid, htf,  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
h1E50  = request.security(syminfo.tickerid, htf,  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h1E200 = request.security(syminfo.tickerid, htf,  ta.ema(close,200), lookahead=barmerge.lookahead_off)
h1Rsi  = request.security(syminfo.tickerid, htf,  ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
h4C    = request.security(syminfo.tickerid, htf2, close,             lookahead=barmerge.lookahead_off)
h4E50  = request.security(syminfo.tickerid, htf2, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h4E200 = request.security(syminfo.tickerid, htf2, ta.ema(close,200), lookahead=barmerge.lookahead_off)
dC     = request.security(syminfo.tickerid, "D",  close,             lookahead=barmerge.lookahead_off)
dE21   = request.security(syminfo.tickerid, "D",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
dE50   = request.security(syminfo.tickerid, "D",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
wC     = request.security(syminfo.tickerid, "W",  close,             lookahead=barmerge.lookahead_off)
wE50   = request.security(syminfo.tickerid, "W",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)

bull1H  = h1C > h1E21  and h1E21 > h1E50  and h1C > h1E200 and h1Rsi > 50
bear1H  = h1C < h1E21  and h1E21 < h1E50  and h1C < h1E200 and h1Rsi < 50
bull4H  = h4C > h4E50  and h4C > h4E200
bear4H  = h4C < h4E50  and h4C < h4E200
bullD   = dC  > dE21   and dE21  > dE50
bearD   = dC  < dE21   and dE21  < dE50
bullW   = wC  > wE50
bearW   = wC  < wE50

tripleBull = bull1H and bull4H and bullD
tripleBear = bear1H and bear4H and bearD
quadBull   = tripleBull and bullW
quadBear   = tripleBear and bearW

// =============================================================================
//  ATR & VOLATILITE
// =============================================================================
atr          = ta.atr(atrLen)
atrAvg       = ta.sma(atr, 50)
volFilter    = atr >= atrAvg * minATR
atrExpanding = atr > atr[1] and atr[1] > atr[2]

// =============================================================================
//  VWAP + BANDES
// =============================================================================
vwap = ta.vwap(close)
vDev = ta.stdev(close, 20)
vUp1 = vwap + vDev
vDn1 = vwap - vDev
vUp2 = vwap + vDev * 2.0
vDn2 = vwap - vDev * 2.0

plot(showVwap ? vwap : na, "VWAP",     color=color.new(#c8d4e8, 50), linewidth=1)
plot(showVwap ? vUp1 : na, "VWAP+1sd", color=color.new(#4477ff, 72), linewidth=1)
plot(showVwap ? vDn1 : na, "VWAP-1sd", color=color.new(#4477ff, 72), linewidth=1)
plot(showVwap ? vUp2 : na, "VWAP+2sd", color=color.new(#9944ff, 78), linewidth=1)
plot(showVwap ? vDn2 : na, "VWAP-2sd", color=color.new(#9944ff, 78), linewidth=1)

// =============================================================================
//  CUMULATIVE DELTA
// =============================================================================
deltaBar  = close > open ? volume : close < open ? -volume : 0
cumDelta  = ta.cum(deltaBar)
cdEma     = ta.ema(cumDelta, 21)
cdBullDiv = close < close[5] and cumDelta > cumDelta[5]
cdBearDiv = close > close[5] and cumDelta < cumDelta[5]

// =============================================================================
//  EMAs
// =============================================================================
e8   = ta.ema(close, 8)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)

plot(showEMAs ? e8   : na, "EMA 8",   color=color.new(#ffe055, 62), linewidth=1)
plot(showEMAs ? e21  : na, "EMA 21",  color=color.new(#44aaff, 62), linewidth=1)
plot(showEMAs ? e50  : na, "EMA 50",  color=color.new(#ff9922, 58), linewidth=1)
plot(showEMAs ? e200 : na, "EMA 200", color=color.new(#ff5555, 50), linewidth=2)

bMom = close > e21 and e8 > e21 and close > vwap and e21 > e50
sMom = close < e21 and e8 < e21 and close < vwap and e21 < e50

// =============================================================================
//  RSI + STOCH RSI
// =============================================================================
rsi         = ta.rsi(close, 14)
stochK      = ta.stoch(rsi, rsi, rsi, 14)
stochD      = ta.ema(stochK, 3)
rsiBullZone = rsi > 45 and rsi < 72
rsiBearZone = rsi < 55 and rsi > 28
rbdiv       = rsi < 40 and close < close[5] and rsi > rsi[5]
rsdiv       = rsi > 60 and close > close[5] and rsi < rsi[5]
stochXupOS  = ta.crossover(stochK,  stochD) and stochK < 30
stochXdnOB  = ta.crossunder(stochK, stochD) and stochK > 70

// =============================================================================
//  MACD
// =============================================================================
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
macdBull = macdL > macdS and macdH > 0 and macdH > macdH[1]
macdBear = macdL < macdS and macdH < 0 and macdH < macdH[1]
macdXup  = ta.crossover(macdL,  macdS) and macdL < 0
macdXdn  = ta.crossunder(macdL, macdS) and macdL > 0

// =============================================================================
//  VOLUME
// =============================================================================
volAvg    = ta.sma(volume, 20)
vSpk      = volume > volAvg * 1.5
vSuperSpk = volume > volAvg * 2.5

// =============================================================================
//  LIQUIDITE  SSL/BSL + EQH/EQL
// =============================================================================
liqH = ta.highest(high[1], swingLen)
liqL = ta.lowest(low[1],   swingLen)

wickDown = math.min(open, close) - low
wickUp   = high - math.max(open, close)

sslStrong = low < liqL and close > liqL and wickDown > atr * 0.4 and close > open
bslStrong = high > liqH and close < liqH and wickUp  > atr * 0.4 and close < open

ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow(low,   5, 5)

var float prevPH5 = na
var float prevPL5 = na

if not na(ph5)
    prevPH5 := ph5
if not na(pl5)
    prevPL5 := pl5

eqHigh = not na(ph5) and not na(prevPH5) and ph5 != prevPH5 and math.abs(ph5 - prevPH5) < atr * 0.15
eqLow  = not na(pl5) and not na(prevPL5) and pl5 != prevPL5 and math.abs(pl5 - prevPL5) < atr * 0.15

if eqHigh
    label.new(bar_index[5], ph5, "EQH", style=label.style_label_down,
         color=color.new(#ff8800, 82), textcolor=color.new(#ff8800, 0), size=size.tiny)
if eqLow
    label.new(bar_index[5], pl5, "EQL", style=label.style_label_up,
         color=color.new(#0099ff, 82), textcolor=color.new(#0099ff, 0), size=size.tiny)

// =============================================================================
//  STRUCTURE DE MARCHE  BOS / CHoCH / MSS
// =============================================================================
var float lsh = na
var float lsl = na

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

if not na(ph)
    lsh := ph
if not na(pl)
    lsl := pl

bosB = not na(lsh) and close > lsh and close[1] <= lsh and bull1H
bosS = not na(lsl) and close < lsl and close[1] >= lsl and bear1H

chB  = not na(lsh) and sslStrong[1] and close > lsh and close[1] <= lsh
chS  = not na(lsl) and bslStrong[1] and close < lsl and close[1] >= lsl
mssB = sslStrong and chB
mssS = bslStrong and chS

var int structureBias = 0
if mssB or chB
    structureBias := 1
if mssS or chS
    structureBias := -1

// =============================================================================
//  DISPLACEMENT
// =============================================================================
strongBullC = close > open and (close - open) > atr * 0.5
strongBearC = close < open and (open - close) > atr * 0.5
dispBull    = strongBullC and strongBullC[1] and (close - open) >= (close[1] - open[1]) * 0.75 and atrExpanding
dispBear    = strongBearC and strongBearC[1] and (open - close) >= (open[1] - close[1]) * 0.75 and atrExpanding

// =============================================================================
//  FAIR VALUE GAP
// =============================================================================
bfvg = low  > high[2] and (low  - high[2]) > atr * 0.15
sfvg = high < low[2]  and (low[2] - high)  > atr * 0.15

var float bFVGTop = na
var float bFVGBot = na
var float sFVGTop = na
var float sFVGBot = na

if bfvg
    bFVGTop := low
    bFVGBot := high[2]
if sfvg
    sFVGTop := low[2]
    sFVGBot := high

ibfvg = not na(bFVGTop) and close >= bFVGBot and close <= bFVGTop and not bfvg
isfvg = not na(sFVGTop) and close >= sFVGBot and close <= sFVGTop and not sfvg

if showFVG and bfvg
    box.new(bar_index - 2, low, bar_index + 15, high[2],
         bgcolor=color.new(#00cc66, 90), border_color=color.new(#00cc66, 60), border_width=1)
if showFVG and sfvg
    box.new(bar_index - 2, low[2], bar_index + 15, high,
         bgcolor=color.new(#cc2222, 90), border_color=color.new(#cc2222, 60), border_width=1)

// =============================================================================
//  ORDER BLOCKS + BREAKER BLOCKS
// =============================================================================
impulseUp   = close > open and (close - open) > atr * 0.5
impulseDown = close < open and (open - close) > atr * 0.5
bob = close[1] < open[1] and impulseUp   and close > high[1]
sob = close[1] > open[1] and impulseDown and close < low[1]

obHi = math.max(open[1], close[1])
obLo = math.min(open[1], close[1])

inBullOB = close >= obLo and close <= obHi and bull1H
inBearOB = close >= obLo and close <= obHi and bear1H

var float lastBobHi = na
var float lastBobLo = na
var float lastSobHi = na
var float lastSobLo = na

if bob
    lastBobHi := math.max(open[1], close[1])
    lastBobLo := math.min(open[1], close[1])
if sob
    lastSobHi := math.max(open[1], close[1])
    lastSobLo := math.min(open[1], close[1])

breakerBull = not na(lastSobHi) and close > lastSobHi and structureBias == 1
breakerBear = not na(lastBobLo) and close < lastBobLo  and structureBias == -1

if showOB and bob
    box.new(bar_index - 1, obLo, bar_index + 12, obHi,
         bgcolor=color.new(#00ff88, 87), border_color=color.new(#00ff88, 52), border_width=1)
if showOB and sob
    box.new(bar_index - 1, obLo, bar_index + 12, obHi,
         bgcolor=color.new(#ff2222, 87), border_color=color.new(#ff2222, 52), border_width=1)
if showOB and breakerBull
    box.new(bar_index - 1, lastSobLo, bar_index + 12, lastSobHi,
         bgcolor=color.new(#00ffcc, 90), border_color=color.new(#00ffcc, 55), border_width=1)
if showOB and breakerBear
    box.new(bar_index - 1, lastBobLo, bar_index + 12, lastBobHi,
         bgcolor=color.new(#ff44aa, 90), border_color=color.new(#ff44aa, 55), border_width=1)

// =============================================================================
//  OTE  Fibonacci 61.8% - 78.6%
// =============================================================================
swH     = ta.highest(high, swingLen * 3)
swL     = ta.lowest(low,   swingLen * 3)
swR     = swH - swL
fib618B = swL + swR * 0.618
fib786B = swL + swR * 0.786
fib618S = swH - swR * 0.618
fib786S = swH - swR * 0.786

inOTEBull = close >= fib618B and close <= fib786B and bull1H
inOTEBear = close >= fib786S and close <= fib618S and bear1H
inEqBull  = close >= swL + swR * 0.382 and close <= swL + swR * 0.618
inEqBear  = close >= swH - swR * 0.618 and close <= swH - swR * 0.382

// =============================================================================
//  PREMIUM / DISCOUNT
// =============================================================================
rangeH  = ta.highest(high, 100)
rangeL  = ta.lowest(low,   100)
rangeM  = (rangeH + rangeL) / 2
dis     = close < rangeM
pre     = close > rangeM
deepDis = close < rangeL + (rangeH - rangeL) * 0.25
deepPre = close > rangeH - (rangeH - rangeL) * 0.25

// =============================================================================
//  PATTERNS CHANDELIER
// =============================================================================
bCdl = close > open and (close - open) > (high - low) * 0.55
sCdl = close < open and (open - close) > (high - low) * 0.55

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and
     (close - open) > math.abs(close[1] - open[1])
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and
     (open - close) > math.abs(close[1] - open[1])

hammerBull = wickDown > math.abs(close - open) * 2.5 and wickDown > wickUp * 3.0 and close > open
hammerBear = wickUp   > math.abs(close - open) * 2.5 and wickUp   > wickDown * 3.0 and close < open

// =============================================================================
//  POWER OF 3
// =============================================================================
po3Bull = inLondon and not na(asianL) and low < asianL and close > asianL and sslStrong and bull1H
po3Bear = inLondon and not na(asianH) and high > asianH and close < asianH and bslStrong and bear1H

// =============================================================================
//  PROXIMITE NIVEAUX CLES
// =============================================================================
nearPDL = not na(pdL) and math.abs(close - pdL) < atr * 0.4
nearPDH = not na(pdH) and math.abs(close - pdH) < atr * 0.4
nearPWL = not na(pwL) and math.abs(close - pwL) < atr * 0.6
nearPWH = not na(pwH) and math.abs(close - pwH) < atr * 0.6
nearNYM = not na(nyMidnightPx) and math.abs(close - nyMidnightPx) < atr * 0.35

// =============================================================================
//  SCORE LONG  max 30
// =============================================================================
ls = 0
ls := ls + (quadBull   ? 6 : tripleBull ? 4 : (bull1H and bull4H) ? 2 : bull1H ? 1 : 0)
ls := ls + (bullD      ? 2 : 0)
ls := ls + (bullW      ? 2 : 0)
ls := ls + (sslStrong  ? 3 : 0)
ls := ls + (mssB ? 4 : chB ? 2 : bosB ? 1 : 0)
ls := ls + ((bfvg or ibfvg)                  ? 2 : 0)
ls := ls + ((bob or inBullOB or breakerBull) ? 2 : 0)
ls := ls + (deepDis    ? 3 : dis      ? 1 : 0)
ls := ls + (inOTEBull  ? 2 : inEqBull ? 1 : 0)
ls := ls + (po3Bull    ? 2 : 0)
ls := ls + (inKillzone ? 1 : 0)
ls := ls + (bMom       ? 1 : 0)
ls := ls + (rsiBullZone ? 1 : 0)
ls := ls + ((macdBull or macdXup)            ? 1 : 0)
ls := ls + (bullEngulf ? 2 : hammerBull ? 2 : bCdl ? 1 : 0)
ls := ls + (stochXupOS ? 1 : 0)
ls := ls + (vSuperSpk  ? 2 : vSpk ? 1 : 0)
ls := ls + (cdBullDiv  ? 1 : 0)
ls := ls + (rbdiv      ? 1 : 0)
ls := ls + (dispBull   ? 1 : 0)
ls := ls + ((nearPDL or nearPWL or nearNYM)  ? 1 : 0)

// =============================================================================
//  SCORE SHORT  max 30
// =============================================================================
ss = 0
ss := ss + (quadBear   ? 6 : tripleBear ? 4 : (bear1H and bear4H) ? 2 : bear1H ? 1 : 0)
ss := ss + (bearD      ? 2 : 0)
ss := ss + (bearW      ? 2 : 0)
ss := ss + (bslStrong  ? 3 : 0)
ss := ss + (mssS ? 4 : chS ? 2 : bosS ? 1 : 0)
ss := ss + ((sfvg or isfvg)                  ? 2 : 0)
ss := ss + ((sob or inBearOB or breakerBear) ? 2 : 0)
ss := ss + (deepPre    ? 3 : pre      ? 1 : 0)
ss := ss + (inOTEBear  ? 2 : inEqBear ? 1 : 0)
ss := ss + (po3Bear    ? 2 : 0)
ss := ss + (inKillzone ? 1 : 0)
ss := ss + (sMom       ? 1 : 0)
ss := ss + (rsiBearZone ? 1 : 0)
ss := ss + ((macdBear or macdXdn)            ? 1 : 0)
ss := ss + (bearEngulf ? 2 : hammerBear ? 2 : sCdl ? 1 : 0)
ss := ss + (stochXdnOB ? 1 : 0)
ss := ss + (vSuperSpk  ? 2 : vSpk ? 1 : 0)
ss := ss + (cdBearDiv  ? 1 : 0)
ss := ss + (rsdiv      ? 1 : 0)
ss := ss + (dispBear   ? 1 : 0)
ss := ss + ((nearPDH or nearPWH or nearNYM)  ? 1 : 0)

// =============================================================================
//  GRADE
// =============================================================================
gr(s) =>
    s >= 26 ? "A++" : s >= 22 ? "A+" : s >= 18 ? "A" :
     s >= 14 ? "B+"  : s >= 10 ? "B"  : "C"

grCol(s) =>
    s >= 26 ? color.new(#00ffcc, 0) :
     s >= 22 ? color.new(#00e676, 0) :
     s >= 18 ? color.new(#22dd55, 0) :
     s >= 14 ? color.new(#aaee22, 15) :
     s >= 10 ? color.new(#ffdd22, 0) : color.gray

// =============================================================================
//  SL / TP
// =============================================================================
longSL  = math.min(low, liqL) - atr * atrMult
shortSL = math.max(high, liqH) + atr * atrMult

slDistL = math.max(close - longSL,  syminfo.mintick)
slDistS = math.max(shortSL - close, syminfo.mintick)

slValidL = slDistL < atr * 5.5 and slDistL > atr * 0.3
slValidS = slDistS < atr * 5.5 and slDistS > atr * 0.3

lTP1 = close + slDistL * rr1
lTP2 = close + slDistL * rr2
lTP3 = close + slDistL * rr3
sTP1 = close - slDistS * rr1
sTP2 = close - slDistS * rr2
sTP3 = close - slDistS * rr3

slPctL = math.round(slDistL / close * 100, 3)
slPctS = math.round(slDistS / close * 100, 3)
levL   = slPctL > 0.001 ? math.round(riskPct / slPctL, 1) : 0.0
levS   = slPctS > 0.001 ? math.round(riskPct / slPctS, 1) : 0.0

// =============================================================================
//  CONDITIONS FINALES
// =============================================================================
canTrade = inKillzone and not newsBlocked and volFilter

longCore = (tripleBull or quadBull or (bull1H and bull4H)) and sslStrong and
     (mssB or chB or po3Bull) and
     (bfvg or ibfvg or bob or breakerBull) and dis

shortCore = (tripleBear or quadBear or (bear1H and bear4H)) and bslStrong and
     (mssS or chS or po3Bear) and
     (sfvg or isfvg or sob or breakerBear) and pre

buyS  = canTrade and ls >= minScoreLong  and longCore  and slValidL
sellS = canTrade and ss >= minScoreShort and shortCore and slValidS

aPPBuy  = buyS  and ls >= 22 and po3Bull and inOTEBull and
     (bullEngulf or hammerBull or vSuperSpk or dispBull)
aPPSell = sellS and ss >= 22 and po3Bear and inOTEBear and
     (bearEngulf or hammerBear or vSuperSpk or dispBear)

// =============================================================================
//  SIGNAUX
// =============================================================================
plotshape(buyS and not aPPBuy,
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00ff88, 0), size=size.large, title="BUY")
plotshape(aPPBuy,
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00ffcc, 0), size=size.huge, title="BUY A++")
plotshape(sellS and not aPPSell,
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#ff3333, 0), size=size.large, title="SELL")
plotshape(aPPSell,
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#ff88cc, 0), size=size.huge, title="SELL A++")
plotshape(po3Bull,
     style=shape.circle, location=location.belowbar,
     color=color.new(#00ffcc, 45), size=size.tiny, title="PO3 Bull")
plotshape(po3Bear,
     style=shape.circle, location=location.abovebar,
     color=color.new(#ff6688, 45), size=size.tiny, title="PO3 Bear")
plotshape(dispBull,
     style=shape.arrowup, location=location.belowbar,
     color=color.new(#44dd88, 50), size=size.small, title="Disp Bull")
plotshape(dispBear,
     style=shape.arrowdown, location=location.abovebar,
     color=color.new(#ff4455, 50), size=size.small, title="Disp Bear")

// =============================================================================
//  LABELS
// =============================================================================
if buyS
    label.new(bar_index, low - atr * 2.8,
         (aPPBuy ? "* BUY " : "^ BUY ") + gr(ls) + "  [" + str.tostring(ls) + "/30]\n" +
         "Entry  : " + str.tostring(math.round(close, 5)) + "\n" +
         "SL     : " + str.tostring(math.round(longSL, 5)) +
             "  (-" + str.tostring(slPctL) + "%)\n" +
         "TP1    : " + str.tostring(math.round(lTP1, 5)) +
             "  (+" + str.tostring(rr1) + "R)\n" +
         "TP2    : " + str.tostring(math.round(lTP2, 5)) +
             "  (+" + str.tostring(rr2) + "R)\n" +
         "TP3    : " + str.tostring(math.round(lTP3, 5)) +
             "  (+" + str.tostring(rr3) + "R)\n" +
         "Risk   : " + str.tostring(riskPct) + "% | Levier " + str.tostring(levL) + "x\n" +
         (po3Bull   ? "PO3 OK | " : "") +
         (inOTEBull ? "OTE 61-79% | " : "") +
         (dispBull  ? "Displacement" : "") + "\n" +
         (inLondon  ? "SESSION: LONDON 08-11h" : "SESSION: NY 15h30-20h"),
         style=label.style_label_up,
         color=color.new(aPPBuy ? #001e33 : #002a1a, 0),
         textcolor=color.new(aPPBuy ? #00ffcc : #00ff88, 0),
         size=size.normal)

if sellS
    label.new(bar_index, high + atr * 2.8,
         (aPPSell ? "* SELL " : "v SELL ") + gr(ss) + "  [" + str.tostring(ss) + "/30]\n" +
         "Entry  : " + str.tostring(math.round(close, 5)) + "\n" +
         "SL     : " + str.tostring(math.round(shortSL, 5)) +
             "  (+" + str.tostring(slPctS) + "%)\n" +
         "TP1    : " + str.tostring(math.round(sTP1, 5)) +
             "  (-" + str.tostring(rr1) + "R)\n" +
         "TP2    : " + str.tostring(math.round(sTP2, 5)) +
             "  (-" + str.tostring(rr2) + "R)\n" +
         "TP3    : " + str.tostring(math.round(sTP3, 5)) +
             "  (-" + str.tostring(rr3) + "R)\n" +
         "Risk   : " + str.tostring(riskPct) + "% | Levier " + str.tostring(levS) + "x\n" +
         (po3Bear   ? "PO3 OK | " : "") +
         (inOTEBear ? "OTE 61-79% | " : "") +
         (dispBear  ? "Displacement" : "") + "\n" +
         (inLondon  ? "SESSION: LONDON 08-11h" : "SESSION: NY 15h30-20h"),
         style=label.style_label_down,
         color=color.new(aPPSell ? #2a0018 : #1e0010, 0),
         textcolor=color.new(aPPSell ? #ff88cc : #ff3333, 0),
         size=size.normal)

// =============================================================================
//  LIGNES SL / TP
// =============================================================================
var line lnSL  = na
var line lnTP1 = na
var line lnTP2 = na
var line lnTP3 = na

if buyS
    if not na(lnSL)
        line.delete(lnSL)
        line.delete(lnTP1)
        line.delete(lnTP2)
        line.delete(lnTP3)
    lnSL  := line.new(bar_index, longSL, bar_index + 40, longSL,
         color=color.new(#ff3333, 12), width=2, style=line.style_dashed)
    lnTP1 := line.new(bar_index, lTP1,   bar_index + 40, lTP1,
         color=color.new(#00ff88, 15), width=1, style=line.style_dotted)
    lnTP2 := line.new(bar_index, lTP2,   bar_index + 40, lTP2,
         color=color.new(#00ffcc, 15), width=1, style=line.style_dotted)
    lnTP3 := line.new(bar_index, lTP3,   bar_index + 40, lTP3,
         color=color.new(#00ddff, 12), width=2, style=line.style_dotted)

if sellS
    if not na(lnSL)
        line.delete(lnSL)
        line.delete(lnTP1)
        line.delete(lnTP2)
        line.delete(lnTP3)
    lnSL  := line.new(bar_index, shortSL, bar_index + 40, shortSL,
         color=color.new(#ff3333, 12), width=2, style=line.style_dashed)
    lnTP1 := line.new(bar_index, sTP1,    bar_index + 40, sTP1,
         color=color.new(#00ff88, 15), width=1, style=line.style_dotted)
    lnTP2 := line.new(bar_index, sTP2,    bar_index + 40, sTP2,
         color=color.new(#00ffcc, 15), width=1, style=line.style_dotted)
    lnTP3 := line.new(bar_index, sTP3,    bar_index + 40, sTP3,
         color=color.new(#00ddff, 12), width=2, style=line.style_dotted)

// =============================================================================
//  NIVEAUX OVERLAY
// =============================================================================
plot(showLvls ? pdH : na, "PDH", color=color.new(#ffaa22, 42), linewidth=1, style=plot.style_linebr)
plot(showLvls ? pdL : na, "PDL", color=color.new(#ffaa22, 42), linewidth=1, style=plot.style_linebr)
plot(showLvls ? pwH : na, "PWH", color=color.new(#ff7700, 38), linewidth=2, style=plot.style_linebr)
plot(showLvls ? pwL : na, "PWL", color=color.new(#ff7700, 38), linewidth=2, style=plot.style_linebr)
plot(showLvls ? pmH : na, "PMH", color=color.new(#ff4400, 32), linewidth=2, style=plot.style_linebr)
plot(showLvls ? pmL : na, "PML", color=color.new(#ff4400, 32), linewidth=2, style=plot.style_linebr)
plot(showLvls and not na(nyMidnightPx) ? nyMidnightPx : na, "NY Midnight",
     color=color.new(#aa77ff, 48), linewidth=1, style=plot.style_linebr)
plot(showAsian and not na(asianH) ? asianH : na, "Asian H",
     color=color.new(#888899, 52), linewidth=1, style=plot.style_linebr)
plot(showAsian and not na(asianL) ? asianL : na, "Asian L",
     color=color.new(#888899, 52), linewidth=1, style=plot.style_linebr)

// =============================================================================
//  BACKGROUNDS
// =============================================================================
bgcolor(inLondon    ? color.new(#0055ff, 96) : na, title="London")
bgcolor(inNY        ? color.new(#ff8800, 96) : na, title="NY")
bgcolor(inAsian     ? color.new(#444455, 97) : na, title="Asian")
bgcolor(newsBlocked ? color.new(#ff0000, 90) : na, title="News")

// =============================================================================
//  DASHBOARD
// =============================================================================
var table db = table.new(position.top_right, 2, 22,
     bgcolor=color.new(#04040e, 0),
     border_color=color.new(#14142a, 50),
     border_width=1,
     frame_color=color.new(#2233cc, 38),
     frame_width=2)

cb = color.new(#070714, 0)
ch = color.new(#0d0d24, 0)

dc(c, r, t, bg, tc) =>
    table.cell(db, c, r, t, bgcolor=bg, text_color=tc, text_size=size.small)

if barstate.islast
    dc(0,  0, "ICT SIGNAL PRO V3", ch, color.white)
    dc(1,  0, syminfo.ticker + " " + timeframe.period, ch, color.new(#ffdd00, 0))
    dc(0,  1, "Session",      cb, color.gray)
    dc(1,  1, inLondon ? "LONDON 08-11h" : inNY ? "NY 15h30-20h" :
         inAsian ? "ASIAN" : "OFF",
         cb, (inLondon or inNY) ? color.green : inAsian ? color.gray : color.red)
    dc(0,  2, "News",         cb, color.gray)
    dc(1,  2, newsBlocked ? "BLOQUE" : "OK",
         cb, newsBlocked ? color.red : color.green)
    dc(0,  3, "Volatilite",   cb, color.gray)
    dc(1,  3, vSuperSpk ? "SPIKE x2.5" : vSpk ? "Spike x1.5" :
         volFilter ? "OK" : "Faible",
         cb, vSuperSpk ? color.new(#ffdd00, 0) : volFilter ? color.green : color.orange)
    dc(0,  4, "Biais " + htf + "H",  cb, color.gray)
    dc(1,  4, bull1H ? "BULL" : bear1H ? "BEAR" : "Neutre",
         cb, bull1H ? color.green : bear1H ? color.red : color.gray)
    dc(0,  5, "Biais " + htf2 + "H", cb, color.gray)
    dc(1,  5, bull4H ? "BULL" : bear4H ? "BEAR" : "Neutre",
         cb, bull4H ? color.green : bear4H ? color.red : color.gray)
    dc(0,  6, "Daily",        cb, color.gray)
    dc(1,  6, bullD ? "BULL" : bearD ? "BEAR" : "Neutre",
         cb, bullD ? color.green : bearD ? color.red : color.gray)
    dc(0,  7, "Weekly",       cb, color.gray)
    dc(1,  7, bullW ? "BULL" : bearW ? "BEAR" : "Neutre",
         cb, bullW ? color.green : bearW ? color.red : color.gray)
    dc(0,  8, "Alignement",   cb, color.gray)
    dc(1,  8, quadBull ? "QUAD BULL" : quadBear ? "QUAD BEAR" :
         tripleBull ? "TRIPLE BULL" : tripleBear ? "TRIPLE BEAR" : "Mixte",
         cb, (quadBull or tripleBull) ? color.new(#00ffcc, 0) :
         (quadBear or tripleBear) ? color.new(#ff4444, 0) : color.gray)
    dc(0,  9, "Structure",    cb, color.gray)
    dc(1,  9, mssB ? "MSS BULL" : mssS ? "MSS BEAR" :
         chB  ? "CHoCH BULL" : chS  ? "CHoCH BEAR" :
         bosB ? "BOS BULL"   : bosS ? "BOS BEAR"   : "---",
         cb, (mssB or chB or bosB) ? color.green : (mssS or chS or bosS) ? color.red : color.gray)
    dc(0, 10, "Liquidite",    cb, color.gray)
    dc(1, 10, sslStrong ? "SSL Sweep" : bslStrong ? "BSL Sweep" :
         eqHigh ? "EQH Pool" : eqLow ? "EQL Pool" : "---",
         cb, sslStrong ? color.green : bslStrong ? color.red :
         (eqHigh or eqLow) ? color.orange : color.gray)
    dc(0, 11, "Zone IPDA",    cb, color.gray)
    dc(1, 11, deepDis ? "DEEP DISCOUNT" : dis ? "Discount" :
         deepPre ? "DEEP PREMIUM" : pre ? "Premium" : "Equilibre",
         cb, dis ? color.green : pre ? color.red : color.gray)
    dc(0, 12, "FVG / OB",     cb, color.gray)
    dc(1, 12, bfvg or ibfvg ? "FVG Bull" : sfvg or isfvg ? "FVG Bear" :
         bob ? "OB Bull" : sob ? "OB Bear" :
         breakerBull ? "Breaker Bull" : breakerBear ? "Breaker Bear" : "---",
         cb, (bfvg or ibfvg or bob or breakerBull) ? color.green :
         (sfvg or isfvg or sob or breakerBear) ? color.red : color.gray)
    dc(0, 13, "Power of 3",   cb, color.gray)
    dc(1, 13, po3Bull ? "PO3 BULL OK" : po3Bear ? "PO3 BEAR OK" : "---",
         cb, po3Bull ? color.new(#00ffcc, 0) : po3Bear ? color.new(#ff88cc, 0) : color.gray)
    dc(0, 14, "OTE Fib",      cb, color.gray)
    dc(1, 14, inOTEBull ? "61-79% BULL" : inOTEBear ? "61-79% BEAR" :
         (inEqBull or inEqBear) ? "EQ 50%" : "---",
         cb, (inOTEBull or inOTEBear) ? color.new(#ffdd00, 0) : color.gray)
    dc(0, 15, "Cum. Delta",   cb, color.gray)
    dc(1, 15, cdBullDiv ? "Div Bull" : cdBearDiv ? "Div Bear" :
         cumDelta > cdEma ? "Positif" : "Negatif",
         cb, cdBullDiv ? color.green : cdBearDiv ? color.red : color.gray)
    dc(0, 16, "Displacement", cb, color.gray)
    dc(1, 16, dispBull ? "Impulsion BULL" : dispBear ? "Impulsion BEAR" : "---",
         cb, dispBull ? color.green : dispBear ? color.red : color.gray)
    dc(0, 17, "Score LONG",   ch, color.gray)
    dc(1, 17, str.tostring(ls) + " / 30   " + gr(ls), ch, grCol(ls))
    dc(0, 18, "Score SHORT",  ch, color.gray)
    dc(1, 18, str.tostring(ss) + " / 30   " + gr(ss), ch, grCol(ss))
    dc(0, 19, "Risk Levier",  cb, color.gray)
    dc(1, 19, str.tostring(riskPct) + "% | " +
         (buyS  ? str.tostring(levL) + "x long" :
          sellS ? str.tostring(levS) + "x short" : "---"),
         cb, color.new(#aaaaff, 0))
    dc(0, 20, "== SIGNAL ==", ch, color.white)
    dc(1, 20, aPPBuy  ? "* BUY A++"   :
         buyS    ? "BUY "  + gr(ls)   :
         aPPSell ? "* SELL A++"       :
         sellS   ? "SELL " + gr(ss)   : "ATTENDRE",
         ch,
         aPPBuy  ? color.new(#00ffcc, 0) : buyS   ? color.new(#00ff88, 0) :
         aPPSell ? color.new(#ff88cc, 0) : sellS  ? color.new(#ff3333, 0) : color.gray)
    dc(0, 21, "NY Midnight",  cb, color.gray)
    dc(1, 21, not na(nyMidnightPx) ? str.tostring(math.round(nyMidnightPx, 5)) : "---",
         cb, color.new(#aa77ff, 0))

// =============================================================================
//  ALERTES  (const string uniquement - requis Pine v6)
// =============================================================================
alertcondition(aPPBuy,      title="BUY A++",         message="BUY A++ {{ticker}} {{interval}} Entry {{close}} ICT Elite Setup")
alertcondition(aPPSell,     title="SELL A++",        message="SELL A++ {{ticker}} {{interval}} Entry {{close}} ICT Elite Setup")
alertcondition(buyS,        title="BUY ICT V3",      message="BUY {{ticker}} {{interval}} Entry {{close}}")
alertcondition(sellS,       title="SELL ICT V3",     message="SELL {{ticker}} {{interval}} Entry {{close}}")
alertcondition(po3Bull,     title="PO3 Bull",        message="POWER OF 3 BULL {{ticker}} {{interval}} Fakeout asiatique")
alertcondition(po3Bear,     title="PO3 Bear",        message="POWER OF 3 BEAR {{ticker}} {{interval}} Fakeout asiatique")
alertcondition(mssB,        title="MSS Bull",        message="MARKET STRUCTURE SHIFT BULL {{ticker}} {{interval}}")
alertcondition(mssS,        title="MSS Bear",        message="MARKET STRUCTURE SHIFT BEAR {{ticker}} {{interval}}")
alertcondition(chB,         title="CHoCH Bull",      message="CHOCH BULLISH {{ticker}} {{interval}}")
alertcondition(chS,         title="CHoCH Bear",      message="CHOCH BEARISH {{ticker}} {{interval}}")
alertcondition(dispBull,    title="Displacement Up", message="DISPLACEMENT BULL {{ticker}} {{interval}}")
alertcondition(dispBear,    title="Displacement Dn", message="DISPLACEMENT BEAR {{ticker}} {{interval}}")
alertcondition(breakerBull, title="Breaker Bull",    message="BREAKER BLOCK BULL {{ticker}} {{interval}}")
alertcondition(breakerBear, title="Breaker Bear",    message="BREAKER BLOCK BEAR {{ticker}} {{interval}}")
alertcondition(eqHigh,      title="EQH Pool",        message="EQUAL HIGHS {{ticker}} liquidite au-dessus")
alertcondition(eqLow,       title="EQL Pool",        message="EQUAL LOWS {{ticker}} liquidite en-dessous")
alertcondition(newsBlocked, title="News Block",      message="NEWS BLOCK {{ticker}} trading suspendu")
