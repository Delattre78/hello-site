//@version=6
// =============================================================================
//  ICT SIGNAL PRO V4 - ULTRA MAX  (Pine Script v6)
//  Graphique 100% propre : seuls BUY / SELL visibles
//  Dashboard 28 lignes : POURQUOI chaque signal a tire
//  Indicateurs : ICT + PA + Volume Profile + Order Flow + Ichimoku + BB + OTE
//  Sessions : London 08h-11h / NY 15h30-20h  (heure Paris)
// =============================================================================
indicator("ICT SIGNAL PRO V4 - ULTRA", overlay=true,
     max_labels_count=0, max_boxes_count=0, max_lines_count=0)

// =============================================================================
//  INPUTS
// =============================================================================
grpR = "Risk"
rr1     = input.float(2.0,  "TP1 R:R",            group=grpR, minval=0.5,  step=0.25)
rr2     = input.float(3.5,  "TP2 R:R",            group=grpR, minval=1.0,  step=0.25)
rr3     = input.float(5.0,  "TP3 R:R",            group=grpR, minval=1.0,  step=0.25)
riskPct = input.float(5.0,  "Risk pct / trade",   group=grpR, minval=0.1,  step=0.1)

grpF = "Filtres"
minScoreLong  = input.int(18, "Score MIN Long  max 38",  group=grpF, minval=8, maxval=38)
minScoreShort = input.int(18, "Score MIN Short max 38",  group=grpF, minval=8, maxval=38)
htf      = input.timeframe("60",  "HTF1 Bias", group=grpF)
htf2     = input.timeframe("240", "HTF2 Bias", group=grpF)
swingLen = input.int(10, "Swing length",       group=grpF, minval=3, maxval=30)
atrLen   = input.int(14, "ATR length",         group=grpF, minval=5)
atrMult  = input.float(1.5, "SL ATR buffer",   group=grpF, step=0.1, minval=0.5)
minATR   = input.float(0.8, "ATR vol filter",  group=grpF, step=0.05, minval=0.1)

grpS = "Sessions Paris"
useLondon = input.bool(true, "London  08h-11h", group=grpS)
useNY     = input.bool(true, "NY      15h30-20h", group=grpS)
useAsian  = input.bool(true, "Asian   01h-08h",  group=grpS)
showBg    = input.bool(true, "Fond sessions",   group=grpS)

grpN = "News"
useNews = input.bool(true, "Bloquer +/- X min", group=grpN)
newsMin = input.int(30, "Minutes",             group=grpN, minval=5, maxval=120)
news1   = input.time(timestamp("05 Jun 2026 12:30 +0000"), "NFP Jun 5",    group=grpN)
news2   = input.time(timestamp("10 Jun 2026 12:30 +0000"), "CPI Jun 10",   group=grpN)
news3   = input.time(timestamp("17 Jun 2026 18:00 +0000"), "FOMC Jun 17",  group=grpN)
news4   = input.time(timestamp("24 Jun 2026 12:30 +0000"), "PCE Jun 24",   group=grpN)
news5   = input.time(timestamp("01 Jul 2026 12:30 +0000"), "NFP Jul 1",    group=grpN)
news6   = input.time(timestamp("08 Jul 2026 12:30 +0000"), "CPI Jul 8",    group=grpN)
news7   = input.time(timestamp("09 Jul 2026 18:00 +0000"), "FOMC Min",     group=grpN)
news8   = input.time(timestamp("29 Jul 2026 18:00 +0000"), "FOMC Jul",     group=grpN)

// =============================================================================
//  NEWS
// =============================================================================
nwMs = newsMin * 60000
nn(t) => math.abs(time - t) <= nwMs
newsBlocked = useNews and (nn(news1) or nn(news2) or nn(news3) or nn(news4) or
     nn(news5) or nn(news6) or nn(news7) or nn(news8))

// =============================================================================
//  SESSIONS
// =============================================================================
inLondon   = useLondon and not na(time(timeframe.period, "0800-1100", "Europe/Paris"))
inNY       = useNY     and not na(time(timeframe.period, "1530-2000", "Europe/Paris"))
inAsian    = useAsian  and not na(time(timeframe.period, "0100-0800", "Europe/Paris"))
inKillzone = inLondon or inNY

var float nyMidnightPx = na
isNYMidnight = not na(time(timeframe.period, "0000-0001", "America/New_York"))
if isNYMidnight
    nyMidnightPx := open

bgcolor(showBg and inLondon    ? color.new(#0055ff, 96) : na, title="London")
bgcolor(showBg and inNY        ? color.new(#ff8800, 96) : na, title="NY")
bgcolor(showBg and inAsian     ? color.new(#444455, 97) : na, title="Asian")
bgcolor(showBg and newsBlocked ? color.new(#ff0000, 90) : na, title="News")

// =============================================================================
//  RANGE ASIATIQUE
// =============================================================================
newDay = ta.change(time("D")) != 0
var float asianH = na
var float asianL = na
if newDay
    asianH := na
    asianL := na
if inAsian
    asianH := na(asianH) ? high : math.max(asianH, high)
    asianL := na(asianL) ? low  : math.min(asianL, low)

// =============================================================================
//  NIVEAUX PRECEDENTS
// =============================================================================
pdH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
pdL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
pwH = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_off)
pwL = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_off)

// =============================================================================
//  BIAIS MULTI-TIMEFRAME  1H / 4H / D / W / M
// =============================================================================
h1C    = request.security(syminfo.tickerid, htf,  close,             lookahead=barmerge.lookahead_off)
h1E21  = request.security(syminfo.tickerid, htf,  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
h1E50  = request.security(syminfo.tickerid, htf,  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h1E200 = request.security(syminfo.tickerid, htf,  ta.ema(close,200), lookahead=barmerge.lookahead_off)
h1Rsi  = request.security(syminfo.tickerid, htf,  ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
h4C    = request.security(syminfo.tickerid, htf2, close,             lookahead=barmerge.lookahead_off)
h4E50  = request.security(syminfo.tickerid, htf2, ta.ema(close, 50), lookahead=barmerge.lookahead_off)
h4E200 = request.security(syminfo.tickerid, htf2, ta.ema(close,200), lookahead=barmerge.lookahead_off)
dC     = request.security(syminfo.tickerid, "D",  close,             lookahead=barmerge.lookahead_off)
dE21   = request.security(syminfo.tickerid, "D",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)
dE50   = request.security(syminfo.tickerid, "D",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
wC     = request.security(syminfo.tickerid, "W",  close,             lookahead=barmerge.lookahead_off)
wE50   = request.security(syminfo.tickerid, "W",  ta.ema(close, 50), lookahead=barmerge.lookahead_off)
mC     = request.security(syminfo.tickerid, "M",  close,             lookahead=barmerge.lookahead_off)
mE21   = request.security(syminfo.tickerid, "M",  ta.ema(close, 21), lookahead=barmerge.lookahead_off)

bull1H  = h1C > h1E21  and h1E21 > h1E50  and h1C > h1E200 and h1Rsi > 50
bear1H  = h1C < h1E21  and h1E21 < h1E50  and h1C < h1E200 and h1Rsi < 50
bull4H  = h4C > h4E50  and h4C > h4E200
bear4H  = h4C < h4E50  and h4C < h4E200
bullD   = dC  > dE21   and dE21  > dE50
bearD   = dC  < dE21   and dE21  < dE50
bullW   = wC  > wE50
bearW   = wC  < wE50
bullM   = mC  > mE21
bearM   = mC  < mE21

tripleBull = bull1H and bull4H and bullD
tripleBear = bear1H and bear4H and bearD
quadBull   = tripleBull and bullW
quadBear   = tripleBear and bearW
pentaBull  = quadBull and bullM
pentaBear  = quadBear and bearM

// =============================================================================
//  ATR
// =============================================================================
atr          = ta.atr(atrLen)
atrAvg       = ta.sma(atr, 50)
volFilter    = atr >= atrAvg * minATR
atrExpanding = atr > atr[1] and atr[1] > atr[2]

// =============================================================================
//  EMAs & VWAP
// =============================================================================
e8   = ta.ema(close, 8)
e13  = ta.ema(close, 13)
e21  = ta.ema(close, 21)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)
vwap = ta.vwap(close)

bMom = close > e21 and e8 > e21 and e13 > e21 and close > vwap and e21 > e50
sMom = close < e21 and e8 < e21 and e13 < e21 and close < vwap and e21 < e50

// =============================================================================
//  ICHIMOKU KINKO HYO
// =============================================================================
ichiTenkan  = (ta.highest(high, 9)  + ta.lowest(low, 9))  / 2
ichiKijun   = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
ichiSenkouA = (ichiTenkan + ichiKijun) / 2
ichiSenkouB = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2

cloudTop = math.max(ichiSenkouA[26], ichiSenkouB[26])
cloudBot = math.min(ichiSenkouA[26], ichiSenkouB[26])

ichiBull = close > cloudTop and ichiTenkan > ichiKijun and close > ichiTenkan
ichiBear = close < cloudBot and ichiTenkan < ichiKijun and close < ichiTenkan
ichiNeutral = close >= cloudBot and close <= cloudTop

// =============================================================================
//  BOLLINGER BANDS
// =============================================================================
bbBasis = ta.sma(close, 20)
bbDev   = ta.stdev(close, 20)
bbUpper = bbBasis + bbDev * 2.0
bbLower = bbBasis - bbDev * 2.0
bbWidth = bbDev * 4.0 / bbBasis

atBBLower = close <= bbLower * 1.002 and bull1H
atBBUpper = close >= bbUpper * 0.998 and bear1H
bbSqueeze = bbWidth < ta.sma(bbWidth, 50) * 0.8

// =============================================================================
//  RSI + STOCH RSI
// =============================================================================
rsi         = ta.rsi(close, 14)
stochK      = ta.stoch(rsi, rsi, rsi, 14)
stochD      = ta.ema(stochK, 3)
rsiBullZone = rsi > 45 and rsi < 72
rsiBearZone = rsi < 55 and rsi > 28
rbdiv       = rsi < 40 and close < close[5] and rsi > rsi[5]
rsdiv       = rsi > 60 and close > close[5] and rsi < rsi[5]
stochXupOS  = ta.crossover(stochK,  stochD) and stochK < 30
stochXdnOB  = ta.crossunder(stochK, stochD) and stochK > 70

// =============================================================================
//  MACD
// =============================================================================
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
macdBull = macdL > macdS and macdH > 0 and macdH > macdH[1]
macdBear = macdL < macdS and macdH < 0 and macdH < macdH[1]
macdXup  = ta.crossover(macdL,  macdS) and macdL < 0
macdXdn  = ta.crossunder(macdL, macdS) and macdL > 0

// =============================================================================
//  VOLUME + ORDER FLOW (Cumulative Delta)
// =============================================================================
volAvg    = ta.sma(volume, 20)
vSpk      = volume > volAvg * 1.5
vSuperSpk = volume > volAvg * 2.5

deltaBar  = close > open ? volume : close < open ? -volume : 0
cumDelta  = ta.cum(deltaBar)
cdEma     = ta.ema(cumDelta, 21)
cdBullDiv = close < close[5] and cumDelta > cumDelta[5]
cdBearDiv = close > close[5] and cumDelta < cumDelta[5]

// Order Flow imbalance (delta vs price)
deltaNet     = ta.ema(deltaBar, 5)
ofBull       = deltaNet > 0 and close > open
ofBear       = deltaNet < 0 and close < open

// =============================================================================
//  VOLUME PROFILE APPROXIMATION  (VPOC = prix avec plus haut volume)
// =============================================================================
vpocLen  = 20
var float vpocPrice = na
var float vpocVol   = 0.0

if barstate.isconfirmed
    maxVol  = 0.0
    vpocTmp = close
    for i = 0 to vpocLen - 1
        if volume[i] > maxVol
            maxVol  := volume[i]
            vpocTmp := close[i]
    vpocVol   := maxVol
    vpocPrice := vpocTmp

priceAboveVPOC = not na(vpocPrice) and close > vpocPrice
priceBelowVPOC = not na(vpocPrice) and close < vpocPrice

// =============================================================================
//  LIQUIDITE  SSL/BSL + EQH/EQL
// =============================================================================
liqH = ta.highest(high[1], swingLen)
liqL = ta.lowest(low[1],   swingLen)

wickDown = math.min(open, close) - low
wickUp   = high - math.max(open, close)

sslStrong = low < liqL and close > liqL and wickDown > atr * 0.4 and close > open
bslStrong = high > liqH and close < liqH and wickUp  > atr * 0.4 and close < open

ph5 = ta.pivothigh(high, 5, 5)
pl5 = ta.pivotlow(low,   5, 5)
var float prevPH5 = na
var float prevPL5 = na
if not na(ph5)
    prevPH5 := ph5
if not na(pl5)
    prevPL5 := pl5
eqHigh = not na(ph5) and not na(prevPH5) and ph5 != prevPH5 and math.abs(ph5 - prevPH5) < atr * 0.15
eqLow  = not na(pl5) and not na(prevPL5) and pl5 != prevPL5 and math.abs(pl5 - prevPL5) < atr * 0.15

// =============================================================================
//  STRUCTURE DE MARCHE  BOS / CHoCH / MSS
// =============================================================================
var float lsh = na
var float lsl = na
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)
if not na(ph)
    lsh := ph
if not na(pl)
    lsl := pl

bosB = not na(lsh) and close > lsh and close[1] <= lsh and bull1H
bosS = not na(lsl) and close < lsl and close[1] >= lsl and bear1H
chB  = not na(lsh) and sslStrong[1] and close > lsh and close[1] <= lsh
chS  = not na(lsl) and bslStrong[1] and close < lsl and close[1] >= lsl
mssB = sslStrong and chB
mssS = bslStrong and chS

var int structureBias = 0
if mssB or chB
    structureBias := 1
if mssS or chS
    structureBias := -1

// =============================================================================
//  DISPLACEMENT
// =============================================================================
strongBullC = close > open and (close - open) > atr * 0.5
strongBearC = close < open and (open - close) > atr * 0.5
dispBull    = strongBullC and strongBullC[1] and (close - open) >= (close[1] - open[1]) * 0.75 and atrExpanding
dispBear    = strongBearC and strongBearC[1] and (open - close) >= (open[1] - close[1]) * 0.75 and atrExpanding

// =============================================================================
//  FAIR VALUE GAP
// =============================================================================
bfvg = low  > high[2] and (low  - high[2]) > atr * 0.15
sfvg = high < low[2]  and (low[2] - high)  > atr * 0.15

var float bFVGTop = na
var float bFVGBot = na
var float sFVGTop = na
var float sFVGBot = na
if bfvg
    bFVGTop := low
    bFVGBot := high[2]
if sfvg
    sFVGTop := low[2]
    sFVGBot := high
ibfvg = not na(bFVGTop) and close >= bFVGBot and close <= bFVGTop and not bfvg
isfvg = not na(sFVGTop) and close >= sFVGBot and close <= sFVGTop and not sfvg

// =============================================================================
//  ORDER BLOCKS + BREAKER BLOCKS
// =============================================================================
impulseUp   = close > open and (close - open) > atr * 0.5
impulseDown = close < open and (open - close) > atr * 0.5
bob = close[1] < open[1] and impulseUp   and close > high[1]
sob = close[1] > open[1] and impulseDown and close < low[1]

obHi = math.max(open[1], close[1])
obLo = math.min(open[1], close[1])
inBullOB = close >= obLo and close <= obHi and bull1H
inBearOB = close >= obLo and close <= obHi and bear1H

var float lastBobHi = na
var float lastBobLo = na
var float lastSobHi = na
var float lastSobLo = na
if bob
    lastBobHi := math.max(open[1], close[1])
    lastBobLo := math.min(open[1], close[1])
if sob
    lastSobHi := math.max(open[1], close[1])
    lastSobLo := math.min(open[1], close[1])

breakerBull = not na(lastSobHi) and close > lastSobHi and structureBias == 1
breakerBear = not na(lastBobLo) and close < lastBobLo  and structureBias == -1

// =============================================================================
//  OTE  Fibonacci 61.8% - 78.6%
// =============================================================================
swH     = ta.highest(high, swingLen * 3)
swL     = ta.lowest(low,   swingLen * 3)
swR     = swH - swL
inOTEBull = close >= swL + swR * 0.618 and close <= swL + swR * 0.786 and bull1H
inOTEBear = close >= swH - swR * 0.786 and close <= swH - swR * 0.618 and bear1H
inEqBull  = close >= swL + swR * 0.382 and close <= swL + swR * 0.618
inEqBear  = close >= swH - swR * 0.618 and close <= swH - swR * 0.382

// =============================================================================
//  PREMIUM / DISCOUNT  IPDA
// =============================================================================
rangeH  = ta.highest(high, 100)
rangeL  = ta.lowest(low,   100)
rangeM  = (rangeH + rangeL) / 2
dis     = close < rangeM
pre     = close > rangeM
deepDis = close < rangeL + (rangeH - rangeL) * 0.25
deepPre = close > rangeH - (rangeH - rangeL) * 0.25

// =============================================================================
//  PATTERNS CHANDELIER
// =============================================================================
bCdl = close > open and (close - open) > (high - low) * 0.55
sCdl = close < open and (open - close) > (high - low) * 0.55

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and
     (close - open) > math.abs(close[1] - open[1])
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and
     (open - close) > math.abs(close[1] - open[1])

hammerBull = wickDown > math.abs(close - open) * 2.5 and wickDown > wickUp * 3.0 and close > open
hammerBear = wickUp   > math.abs(close - open) * 2.5 and wickUp   > wickDown * 3.0 and close < open

// Doji (indecision - ignore in scoring but show in dashboard)
dojiBody   = math.abs(close - open) < (high - low) * 0.1
doji       = dojiBody and (high - low) > atr * 0.5

// =============================================================================
//  POWER OF 3
// =============================================================================
po3Bull = inLondon and not na(asianL) and low < asianL and close > asianL and sslStrong and bull1H
po3Bear = inLondon and not na(asianH) and high > asianH and close < asianH and bslStrong and bear1H

// =============================================================================
//  PROXIMITE NIVEAUX CLES
// =============================================================================
nearPDL = not na(pdL) and math.abs(close - pdL) < atr * 0.4
nearPDH = not na(pdH) and math.abs(close - pdH) < atr * 0.4
nearPWL = not na(pwL) and math.abs(close - pwL) < atr * 0.6
nearPWH = not na(pwH) and math.abs(close - pwH) < atr * 0.6
nearNYM = not na(nyMidnightPx) and math.abs(close - nyMidnightPx) < atr * 0.35

// =============================================================================
//  SCORE LONG  max ~38 (impossible d obtenir tous les points simultanement)
// =============================================================================
ls = 0
// Alignement multi-TF (max 8)
ls := ls + (pentaBull ? 8 : quadBull ? 7 : tripleBull ? 5 : (bull1H and bull4H) ? 3 : bull1H ? 1 : 0)
// Biais D/W/M (max 6)
ls := ls + (bullD ? 2 : 0)
ls := ls + (bullW ? 2 : 0)
ls := ls + (bullM ? 2 : 0)
// Liquidite (max 4)
ls := ls + (sslStrong ? 4 : 0)
// Structure (max 5)
ls := ls + (mssB ? 5 : chB ? 3 : bosB ? 1 : 0)
// FVG (max 3)
ls := ls + ((bfvg or ibfvg) ? 3 : 0)
// OB / Breaker (max 3)
ls := ls + ((bob or inBullOB or breakerBull) ? 3 : 0)
// Zone IPDA (max 4)
ls := ls + (deepDis ? 4 : dis ? 2 : 0)
// OTE (max 3)
ls := ls + (inOTEBull ? 3 : inEqBull ? 1 : 0)
// PO3 (max 3)
ls := ls + (po3Bull ? 3 : 0)
// Session killzone (max 2)
ls := ls + (inKillzone ? 2 : 0)
// Ichimoku (max 3)
ls := ls + (ichiBull ? 3 : 0)
// Bollinger (max 2)
ls := ls + (atBBLower ? 2 : 0)
// Volume Profile (max 1)
ls := ls + (priceAboveVPOC ? 1 : 0)
// Order Flow (max 2)
ls := ls + (ofBull ? 1 : 0)
ls := ls + (cdBullDiv ? 1 : 0)
// Momentum EMA+VWAP (max 2)
ls := ls + (bMom ? 2 : 0)
// RSI (max 2)
ls := ls + (rsiBullZone ? 1 : 0)
ls := ls + (rbdiv ? 1 : 0)
// StochRSI (max 2)
ls := ls + (stochXupOS ? 2 : 0)
// MACD (max 2)
ls := ls + ((macdBull or macdXup) ? 2 : 0)
// Chandelier (max 3)
ls := ls + (bullEngulf ? 3 : hammerBull ? 2 : bCdl ? 1 : 0)
// Volume (max 3)
ls := ls + (vSuperSpk ? 3 : vSpk ? 2 : 0)
// Displacement (max 2)
ls := ls + (dispBull ? 2 : 0)
// Niveaux cles (max 2)
ls := ls + ((nearPDL or nearPWL or nearNYM) ? 2 : 0)
// EQH/EQL pool (max 1)
ls := ls + (eqLow ? 1 : 0)

// =============================================================================
//  SCORE SHORT  max ~38
// =============================================================================
ss = 0
ss := ss + (pentaBear ? 8 : quadBear ? 7 : tripleBear ? 5 : (bear1H and bear4H) ? 3 : bear1H ? 1 : 0)
ss := ss + (bearD ? 2 : 0)
ss := ss + (bearW ? 2 : 0)
ss := ss + (bearM ? 2 : 0)
ss := ss + (bslStrong ? 4 : 0)
ss := ss + (mssS ? 5 : chS ? 3 : bosS ? 1 : 0)
ss := ss + ((sfvg or isfvg) ? 3 : 0)
ss := ss + ((sob or inBearOB or breakerBear) ? 3 : 0)
ss := ss + (deepPre ? 4 : pre ? 2 : 0)
ss := ss + (inOTEBear ? 3 : inEqBear ? 1 : 0)
ss := ss + (po3Bear ? 3 : 0)
ss := ss + (inKillzone ? 2 : 0)
ss := ss + (ichiBear ? 3 : 0)
ss := ss + (atBBUpper ? 2 : 0)
ss := ss + (priceBelowVPOC ? 1 : 0)
ss := ss + (ofBear ? 1 : 0)
ss := ss + (cdBearDiv ? 1 : 0)
ss := ss + (sMom ? 2 : 0)
ss := ss + (rsiBearZone ? 1 : 0)
ss := ss + (rsdiv ? 1 : 0)
ss := ss + (stochXdnOB ? 2 : 0)
ss := ss + ((macdBear or macdXdn) ? 2 : 0)
ss := ss + (bearEngulf ? 3 : hammerBear ? 2 : sCdl ? 1 : 0)
ss := ss + (vSuperSpk ? 3 : vSpk ? 2 : 0)
ss := ss + (dispBear ? 2 : 0)
ss := ss + ((nearPDH or nearPWH or nearNYM) ? 2 : 0)
ss := ss + (eqHigh ? 1 : 0)

// =============================================================================
//  GRADE
// =============================================================================
gr(s) =>
    s >= 32 ? "A++" : s >= 28 ? "A+" : s >= 24 ? "A" :
     s >= 20 ? "B+"  : s >= 15 ? "B"  : "C"

grCol(s) =>
    s >= 32 ? color.new(#00ffcc, 0) :
     s >= 28 ? color.new(#00e676, 0) :
     s >= 24 ? color.new(#22dd55, 0) :
     s >= 20 ? color.new(#aaee22, 0) :
     s >= 15 ? color.new(#ffdd22, 0) : color.gray

// =============================================================================
//  SL / TP
// =============================================================================
longSL  = math.min(low, liqL) - atr * atrMult
shortSL = math.max(high, liqH) + atr * atrMult

slDistL = math.max(close - longSL,  syminfo.mintick)
slDistS = math.max(shortSL - close, syminfo.mintick)

slValidL = slDistL < atr * 5.5 and slDistL > atr * 0.3
slValidS = slDistS < atr * 5.5 and slDistS > atr * 0.3

lTP1 = close + slDistL * rr1
lTP2 = close + slDistL * rr2
lTP3 = close + slDistL * rr3
sTP1 = close - slDistS * rr1
sTP2 = close - slDistS * rr2
sTP3 = close - slDistS * rr3

slPctL = math.round(slDistL / close * 100, 3)
slPctS = math.round(slDistS / close * 100, 3)
levL   = slPctL > 0.001 ? math.round(riskPct / slPctL, 1) : 0.0
levS   = slPctS > 0.001 ? math.round(riskPct / slPctS, 1) : 0.0

// =============================================================================
//  CONDITIONS FINALES
// =============================================================================
canTrade = inKillzone and not newsBlocked and volFilter

longCore = (tripleBull or quadBull or pentaBull or (bull1H and bull4H)) and sslStrong and
     (mssB or chB or po3Bull) and
     (bfvg or ibfvg or bob or breakerBull) and dis

shortCore = (tripleBear or quadBear or pentaBear or (bear1H and bear4H)) and bslStrong and
     (mssS or chS or po3Bear) and
     (sfvg or isfvg or sob or breakerBear) and pre

buyS  = canTrade and ls >= minScoreLong  and longCore  and slValidL
sellS = canTrade and ss >= minScoreShort and shortCore and slValidS

aPPBuy  = buyS  and ls >= 28 and po3Bull and inOTEBull and (bullEngulf or hammerBull or dispBull)
aPPSell = sellS and ss >= 28 and po3Bear and inOTEBear and (bearEngulf or hammerBear or dispBear)

// =============================================================================
//  RAISON DU SIGNAL (WHY)
// =============================================================================
buildWhy(isLong) =>
    r = ""
    if isLong
        r := r + (pentaBull ? "PENTA|" : quadBull ? "QUAD|" : tripleBull ? "TRIPLE|" : "")
        r := r + (mssB  ? "MSS|"   : chB  ? "CHoCH|"  : bosB  ? "BOS|"   : "")
        r := r + (po3Bull  ? "PO3|"  : "")
        r := r + (bfvg  ? "FVG|"   : ibfvg ? "iFVG|" : "")
        r := r + (bob   ? "OB|"    : breakerBull ? "BRKR|" : "")
        r := r + (inOTEBull ? "OTE|" : "")
        r := r + (sslStrong ? "SSL|"  : "")
        r := r + (deepDis ? "DISC|" : "")
        r := r + (ichiBull ? "ICHI|" : "")
        r := r + (dispBull ? "DISP|" : "")
        r := r + (atBBLower ? "BB|"  : "")
        r := r + (bullEngulf ? "ENG|": hammerBull ? "HAMM|" : "")
        r := r + (cdBullDiv ? "dDEL|" : "")
        r := r + (vSuperSpk ? "VXX|": vSpk ? "VX|" : "")
    else
        r := r + (pentaBear ? "PENTA|" : quadBear ? "QUAD|" : tripleBear ? "TRIPLE|" : "")
        r := r + (mssS  ? "MSS|"   : chS  ? "CHoCH|"  : bosS  ? "BOS|"   : "")
        r := r + (po3Bear  ? "PO3|"  : "")
        r := r + (sfvg  ? "FVG|"   : isfvg ? "iFVG|" : "")
        r := r + (sob   ? "OB|"    : breakerBear ? "BRKR|" : "")
        r := r + (inOTEBear ? "OTE|" : "")
        r := r + (bslStrong ? "BSL|"  : "")
        r := r + (deepPre ? "PREM|" : "")
        r := r + (ichiBear ? "ICHI|" : "")
        r := r + (dispBear ? "DISP|" : "")
        r := r + (atBBUpper ? "BB|"  : "")
        r := r + (bearEngulf ? "ENG|": hammerBear ? "HAMM|" : "")
        r := r + (cdBearDiv ? "dDEL|" : "")
        r := r + (vSuperSpk ? "VXX|": vSpk ? "VX|" : "")
    r

// =============================================================================
//  SIGNAUX VISUELS  (UNIQUEMENT BUY / SELL)
// =============================================================================
plotshape(buyS and not aPPBuy,
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00ff88, 0), size=size.large, title="BUY")
plotshape(aPPBuy,
     style=shape.triangleup, location=location.belowbar,
     color=color.new(#00ffcc, 0), size=size.huge, title="BUY A++")
plotshape(sellS and not aPPSell,
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#ff3333, 0), size=size.large, title="SELL")
plotshape(aPPSell,
     style=shape.triangledown, location=location.abovebar,
     color=color.new(#ff88cc, 0), size=size.huge, title="SELL A++")

// =============================================================================
//  DASHBOARD ULTRA-COMPLET  28 lignes
// =============================================================================
var table db = table.new(position.top_right, 2, 28,
     bgcolor=color.new(#03030c, 0),
     border_color=color.new(#111128, 50),
     border_width=1,
     frame_color=color.new(#1a2299, 40),
     frame_width=2)

cb = color.new(#06061a, 0)
ch = color.new(#0a0a22, 0)
cs = color.new(#020212, 0)

dc(c, r, t, bg, tc) =>
    table.cell(db, c, r, t, bgcolor=bg, text_color=tc, text_size=size.small)

if barstate.islast
    // --- HEADER ---
    dc(0,  0, "ICT V4 ULTRA",  ch, color.white)
    dc(1,  0, syminfo.ticker + " " + timeframe.period, ch, color.new(#ffdd00, 0))

    // --- CONTEXTE ---
    dc(0,  1, "Session",      cb, color.gray)
    dc(1,  1, inLondon ? "LONDON 08-11h" : inNY ? "NY 15h30-20h" :
         inAsian ? "ASIAN" : "OFF",
         cb, (inLondon or inNY) ? color.green : inAsian ? color.gray : color.red)

    dc(0,  2, "News",         cb, color.gray)
    dc(1,  2, newsBlocked ? "BLOQUE" : "OK",
         cb, newsBlocked ? color.red : color.green)

    dc(0,  3, "Volatilite",   cb, color.gray)
    dc(1,  3, vSuperSpk ? "SPIKE x2.5" : vSpk ? "Spike x1.5" :
         volFilter ? "OK" : "Faible",
         cb, vSuperSpk ? color.new(#ffdd00, 0) : volFilter ? color.green : color.orange)

    // --- BIAIS MULTI-TF ---
    dc(0,  4, "Biais " + htf + "H", cb, color.gray)
    dc(1,  4, bull1H ? "BULL" : bear1H ? "BEAR" : "Neutre",
         cb, bull1H ? color.green : bear1H ? color.red : color.gray)

    dc(0,  5, "Biais " + htf2 + "H", cb, color.gray)
    dc(1,  5, bull4H ? "BULL" : bear4H ? "BEAR" : "Neutre",
         cb, bull4H ? color.green : bear4H ? color.red : color.gray)

    dc(0,  6, "Daily",        cb, color.gray)
    dc(1,  6, bullD ? "BULL" : bearD ? "BEAR" : "Neutre",
         cb, bullD ? color.green : bearD ? color.red : color.gray)

    dc(0,  7, "Weekly",       cb, color.gray)
    dc(1,  7, bullW ? "BULL" : bearW ? "BEAR" : "Neutre",
         cb, bullW ? color.green : bearW ? color.red : color.gray)

    dc(0,  8, "Monthly",      cb, color.gray)
    dc(1,  8, bullM ? "BULL" : bearM ? "BEAR" : "Neutre",
         cb, bullM ? color.green : bearM ? color.red : color.gray)

    dc(0,  9, "Alignement",   cb, color.gray)
    dc(1,  9, pentaBull ? "PENTA BULL" : pentaBear ? "PENTA BEAR" :
         quadBull ? "QUAD BULL" : quadBear ? "QUAD BEAR" :
         tripleBull ? "TRIPLE BULL" : tripleBear ? "TRIPLE BEAR" : "Mixte",
         cb, (pentaBull or quadBull or tripleBull) ? color.new(#00ffcc, 0) :
         (pentaBear or quadBear or tripleBear) ? color.new(#ff4444, 0) : color.gray)

    // --- ICT CONCEPTS ---
    dc(0, 10, "Structure",    cb, color.gray)
    dc(1, 10, mssB ? "MSS BULL" : mssS ? "MSS BEAR" :
         chB ? "CHoCH BULL" : chS ? "CHoCH BEAR" :
         bosB ? "BOS BULL" : bosS ? "BOS BEAR" : "---",
         cb, (mssB or chB or bosB) ? color.green : (mssS or chS or bosS) ? color.red : color.gray)

    dc(0, 11, "Liquidite",    cb, color.gray)
    dc(1, 11, sslStrong ? "SSL Sweep" : bslStrong ? "BSL Sweep" :
         eqHigh ? "EQH Pool" : eqLow ? "EQL Pool" : "---",
         cb, sslStrong ? color.green : bslStrong ? color.red :
         (eqHigh or eqLow) ? color.orange : color.gray)

    dc(0, 12, "Zone IPDA",    cb, color.gray)
    dc(1, 12, deepDis ? "DEEP DISCOUNT" : dis ? "Discount" :
         deepPre ? "DEEP PREMIUM" : pre ? "Premium" : "Equilibre",
         cb, dis ? color.green : pre ? color.red : color.gray)

    dc(0, 13, "FVG / OB",     cb, color.gray)
    dc(1, 13, bfvg or ibfvg ? "FVG Bull" : sfvg or isfvg ? "FVG Bear" :
         bob ? "OB Bull" : sob ? "OB Bear" :
         breakerBull ? "Breaker Bull" : breakerBear ? "Breaker Bear" : "---",
         cb, (bfvg or ibfvg or bob or breakerBull) ? color.green :
         (sfvg or isfvg or sob or breakerBear) ? color.red : color.gray)

    dc(0, 14, "Power of 3",   cb, color.gray)
    dc(1, 14, po3Bull ? "PO3 BULL" : po3Bear ? "PO3 BEAR" : "---",
         cb, po3Bull ? color.new(#00ffcc, 0) : po3Bear ? color.new(#ff88cc, 0) : color.gray)

    dc(0, 15, "OTE Fib",      cb, color.gray)
    dc(1, 15, inOTEBull ? "61-79% BULL" : inOTEBear ? "61-79% BEAR" :
         (inEqBull or inEqBear) ? "EQ 50%" : "---",
         cb, (inOTEBull or inOTEBear) ? color.new(#ffdd00, 0) : color.gray)

    dc(0, 16, "Displacement", cb, color.gray)
    dc(1, 16, dispBull ? "Impulsion BULL" : dispBear ? "Impulsion BEAR" : "---",
         cb, dispBull ? color.green : dispBear ? color.red : color.gray)

    // --- INDICATEURS TECHNIQUES ---
    dc(0, 17, "Ichimoku",     cb, color.gray)
    dc(1, 17, ichiBull ? "BULL (dessus)" : ichiBear ? "BEAR (dessous)" :
         ichiNeutral ? "DANS LE NUAGE" : "---",
         cb, ichiBull ? color.green : ichiBear ? color.red : color.orange)

    dc(0, 18, "Bollinger",    cb, color.gray)
    dc(1, 18, atBBLower ? "BANDE BASSE" : atBBUpper ? "BANDE HAUTE" :
         bbSqueeze ? "SQUEEZE" : "Normal",
         cb, atBBLower ? color.green : atBBUpper ? color.red :
         bbSqueeze ? color.new(#ffdd00, 0) : color.gray)

    dc(0, 19, "Vol Profile",  cb, color.gray)
    dc(1, 19, priceAboveVPOC ? "Dessus VPOC" : priceBelowVPOC ? "Dessous VPOC" : "---",
         cb, priceAboveVPOC ? color.green : priceBelowVPOC ? color.red : color.gray)

    dc(0, 20, "Order Flow",   cb, color.gray)
    dc(1, 20, cdBullDiv ? "Delta Div BULL" : cdBearDiv ? "Delta Div BEAR" :
         ofBull ? "Flux ACHAT" : ofBear ? "Flux VENTE" : "Neutre",
         cb, (cdBullDiv or ofBull) ? color.green : (cdBearDiv or ofBear) ? color.red : color.gray)

    dc(0, 21, "RSI/MACD",     cb, color.gray)
    dc(1, 21, (macdXup or stochXupOS) ? "Cross BULL" :
         (macdXdn or stochXdnOB) ? "Cross BEAR" :
         rsiBullZone ? "RSI Zone B" : rsiBearZone ? "RSI Zone S" : "---",
         cb, (macdXup or stochXupOS or rsiBullZone) ? color.green :
         (macdXdn or stochXdnOB or rsiBearZone) ? color.red : color.gray)

    // --- SCORES & SIGNAL ---
    dc(0, 22, "Score LONG",   ch, color.gray)
    dc(1, 22, str.tostring(ls) + " / 38   " + gr(ls), ch, grCol(ls))

    dc(0, 23, "Score SHORT",  ch, color.gray)
    dc(1, 23, str.tostring(ss) + " / 38   " + gr(ss), ch, grCol(ss))

    dc(0, 24, "== SIGNAL ==", cs, color.white)
    dc(1, 24, aPPBuy  ? "* BUY A++"   :
         buyS    ? "BUY "  + gr(ls)   :
         aPPSell ? "* SELL A++"       :
         sellS   ? "SELL " + gr(ss)   : "ATTENDRE",
         cs,
         aPPBuy  ? color.new(#00ffcc, 0) : buyS   ? color.new(#00ff88, 0) :
         aPPSell ? color.new(#ff88cc, 0) : sellS  ? color.new(#ff3333, 0) : color.gray)

    // --- ENTREE / SL / TP ---
    dc(0, 25, "Entry/SL/TP",  cb, color.gray)
    dc(1, 25, buyS or sellS ?
         str.tostring(math.round(close, 5)) + " | SL " +
         str.tostring(math.round(buyS ? longSL : shortSL, 5)) +
         " | TP1 " + str.tostring(math.round(buyS ? lTP1 : sTP1, 5))
         : "---",
         cb, (buyS or sellS) ? color.new(#aaaaff, 0) : color.gray)

    // --- POURQUOI ---
    dc(0, 26, "POURQUOI",     ch, color.gray)
    dc(1, 26, buyS  ? buildWhy(true)  :
         sellS ? buildWhy(false) : "Conditions non remplies",
         ch, buyS ? color.new(#00ff88, 0) : sellS ? color.new(#ff3333, 0) : color.gray)

    // --- RISQUE / LEVIER ---
    dc(0, 27, "Risk / Levier", cb, color.gray)
    dc(1, 27, str.tostring(riskPct) + "% | " +
         (buyS  ? str.tostring(levL) + "x long" :
          sellS ? str.tostring(levS) + "x short" : "---"),
         cb, color.new(#aaaaff, 0))

// =============================================================================
//  ALERTES
// =============================================================================
alertcondition(aPPBuy,      title="BUY A++",         message="BUY A++ {{ticker}} {{interval}} Entry {{close}} ICT Elite")
alertcondition(aPPSell,     title="SELL A++",        message="SELL A++ {{ticker}} {{interval}} Entry {{close}} ICT Elite")
alertcondition(buyS,        title="BUY ICT V4",      message="BUY {{ticker}} {{interval}} Entry {{close}}")
alertcondition(sellS,       title="SELL ICT V4",     message="SELL {{ticker}} {{interval}} Entry {{close}}")
alertcondition(po3Bull,     title="PO3 Bull",        message="POWER OF 3 BULL {{ticker}} {{interval}}")
alertcondition(po3Bear,     title="PO3 Bear",        message="POWER OF 3 BEAR {{ticker}} {{interval}}")
alertcondition(mssB,        title="MSS Bull",        message="MSS BULL {{ticker}} {{interval}}")
alertcondition(mssS,        title="MSS Bear",        message="MSS BEAR {{ticker}} {{interval}}")
alertcondition(chB,         title="CHoCH Bull",      message="CHOCH BULL {{ticker}} {{interval}}")
alertcondition(chS,         title="CHoCH Bear",      message="CHOCH BEAR {{ticker}} {{interval}}")
alertcondition(dispBull,    title="Displacement Up", message="DISPLACEMENT BULL {{ticker}}")
alertcondition(dispBear,    title="Displacement Dn", message="DISPLACEMENT BEAR {{ticker}}")
alertcondition(breakerBull, title="Breaker Bull",    message="BREAKER BULL {{ticker}}")
alertcondition(breakerBear, title="Breaker Bear",    message="BREAKER BEAR {{ticker}}")
alertcondition(eqHigh,      title="EQH Pool",        message="EQUAL HIGHS {{ticker}}")
alertcondition(eqLow,       title="EQL Pool",        message="EQUAL LOWS {{ticker}}")
alertcondition(newsBlocked, title="News Block",      message="NEWS BLOCK {{ticker}}")
